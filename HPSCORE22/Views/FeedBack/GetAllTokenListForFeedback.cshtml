@model RetailCare.Models.ServiceViewModel.FeedBackViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<script src='https://kit.fontawesome.com/a076d05399.js' crossorigin='anonymous'></script>
<div class="card">
    <div class="top-border"></div>
    <div class="card-header entryfromheader">
        <h3 class="card-title"> Assign List for Feedback</h3>
    </div>
    <div class="card-body">
        <table id="locationTable" class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Ticket ID</th>
                    <th>Customer Name</th>
                    <th>Contact No</th>
                    <th>Customer Address</th>
                    <th>Product Name</th>
                    <th>Problem Name</th>
                    <th>Assign Zone</th>
                    <th>Assign Person</th>
                    <th>Status Name</th>
                    <th>Complain Date</th>
                    <th class="text-center">SendToFeedback</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.AssignmentListForFeedback)
                {
                    <tr>
                        <td>@item.TICKETID</td>
                        <td>@item.CUSTOMERNAME</td>
                        <td>@item.CUSTOMERCONTACTNO</td>
                        <td>@item.CUSTOMERADDRESS</td>
                        <td>@item.PRODUCTNAME</td>
                        <td>@item.PROBLEMNAME</td>
                        <td>@item.ZONENAME</td>
                        <td>@item.TECHNICIANNAME</td>
                        <td>@item.STATUSNAME</td>
                        <td>@item.COMPLAINDATE</td>
                        <td class="text-center">
                            <a asp-area=""
                               asp-controller="FeedBack"
                               asp-action="CreateNewFeedback"
                               asp-route-id="@item.TICKETID"
                               class="btn btn-sm btn-warning me-1">
                                <i class="fas fa-arrow-alt-circle-right"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>
</div>

<!-- JS -->
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<!--Data Table-->
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<style>
    .entryfromheader {
        width: 100% !important;
        margin-left: 0% !important;
    }
</style>
<script>
    $(document).ready(function () {
        $('#locationTable').DataTable({
            pageLength: 5,
            lengthMenu: [5, 10, 25, 50],
            ordering: true,
            searching: true,
            paging: true,
            info: true,
            autoWidth: false,
            responsive: true, // ✅ better UI

            language: {
                search: "🔍 Search:",
                lengthMenu: "Show _MENU_ entries",
                zeroRecords: "No matching locations found",
                info: "Showing _START_ to _END_ of _TOTAL_ locations",
                infoEmpty: "No data available"
            },

            columnDefs: [
                { orderable: false, targets: 5 } // action column
            ]
        });
    });

    function confirmDelete() {
        return confirm("⚠️ Are you sure you want to delete?");
    }
</script>
<!--Data Table-->