<style>
    .app-sidebar {
        max-width: 220px !important;
    }

    .sidebar-collapse .app-sidebar {
        max-width: 175px !important;
    }
    .top-border {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 5px;
        background: #ff5b17;
        border-radius: 6px 6px 0 0;
    }
    .entryfromheader{
        padding: 0.5%;
        background-color: #c2defa;
        margin-top: .5%;
        margin-left: 0.5%;
        color: black;
        width: 102%;
        margin-left: -1%;
    }
    .frombody {
        border-radius: 12px;
    }

 /*    .form-control,
    .form-select {
        height: 50px;
        border: none;
        background: #f5f5f5;
        border-radius: 3px;
        box-shadow: none;
    } */

    .fromdetails {
        height: 50px !important;
        border: none;
        background: #f5f5f5;
        border-radius: 3px;
    }
    .form-control,
    .multieselectordropdown {
        height: 36px !important;
        box-shadow: none;
        border: gray solid 1px;
        background: #f5f5f5;
        border-radius: 5px;
    }
    .form-control:focus,
    .form-select:focus {
        background: #fff;
        border: 1px solid #ff5b17;
        box-shadow: none;
    }

    .form-check-input {
        width: 18px;
        height: 18px;
        margin-top: .25em;
    }
        .form-check-input:checked {
            background-color: #ff5b17;
            border-color: #ff5b17;
        }
    .send-btn {
        background: #ff5b17;
        color: #fff;
        border: none;
        padding: 12px 45px;
        border-radius: 4px;
        font-weight: 500;
        transition: .3s;
    }
        .send-btn:hover {
            background: #e84c0f;
            color: #fff;
        }

    .select-wrapper {
        position: relative;
    }

        .select-wrapper .form-select {
            height: 50px;
            background: #f5f5f5;
            border: none;
            appearance: none;
            -webkit-appearance: none;
            -moz-appearance: none;
            padding-right: 50px;
        }

        .select-wrapper::after {
            content: "▼";
            position: absolute;
            top: 0;
            right: 0;
            width: 40px;
            height: 50px;
            background: #ff5b17;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            pointer-events: none;
            font-size: 12px;
        }
</style>