<!-- SweetAlert2 -->
<script src="~/js/sweetalert2.min.js" asp-append-version="true"></script>
<!--Insertion MSG-->
@if (TempData["SuccessMSG"] != null)
{
    <script>
        Swal.fire({
            position: "top-end",
            icon: "success",
            title: "@TempData["SuccessMSG"]",
            showConfirmButton: false,
            timer: 1500
        });
    </script>
}
<!--Error MSG-->
