<style>
    .app-header {
        position: sticky;
        top: 0;
        z-index: 1030; /* ensures it stays above other content */
    }
</style>
<!--begin::Header-->
<nav class="app-header navbar navbar-expand bg-body shadow-sm">
    <div class="container-fluid">

        <!-- Navbar Left -->
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button">
                    <i class="fa-solid fa-align-right"></i>
                </a>
            </li>
        </ul>

        <!-- Navbar Right -->
        <ul class="navbar-nav ms-auto">
            <!-- Fullscreen Toggle -->
            <li class="nav-item">
                <a class="nav-link" href="#" data-lte-toggle="fullscreen">
                    <i data-lte-icon="maximize" class="bi bi-arrows-fullscreen"></i>
                    <i data-lte-icon="minimize" class="bi bi-fullscreen-exit" style="display: none"></i>
                </a>
            </li>

            <li class="nav-item dropdown user-menu" onclick="logoutModuleOpen()">
                <a href="#" class="nav-link dropdown-toggle d-flex align-items-center" data-bs-toggle="dropdown" id="imagelink" onclick="logoutModuleOpen()">
                    <!-- Optional small avatar on navbar -->
                    <img src="~/assets/img/pf1.png" class="rounded-circle me-2" style="width:32px; height:32px;" alt="User Image" onclick="logoutModuleOpen()" />
                    <span class="d-none d-md-inline fw-semibold text-dark">
                        @* @Context.Session.GetString("USERID") *@
                    </span>
                </a>

                <ul class="dropdown-menu dropdown-menu-lg dropdown-menu-end shadow-lg border-0" style="min-width:200px;" id="topnavbarmenu">
                    <!-- User Header -->
                    <li class="user-header text-center p-3 text-white" style="background: linear-gradient(135deg, #667eea, skyblue); border-bottom:1px solid rgba(255,255,255,0.2);">
                        <img src="~/assets/img/pf1.png" class="rounded-circle shadow mb-2" style="width:64px; height:64px;" alt="User Image" />
                        <p class="mb-0 fw-bold">@Context.Session.GetString("USERID")</p>
                        @* <small class="text-light">@Context.Session.GetString("DIST_NAME"):@Context.Session.GetString("DUSR_WHID")</small> *@
                        <small class="text-light d-block opacity-75">
                            @Context.Session.GetString("USERID")
                            <span class="mx-1">•</span>
                            @Context.Session.GetString("USERID")
                        </small>
                    </li>

                    <!-- Menu Footer -->
                    <li class="user-footer text-center p-2">
                        <a asp-area="" asp-controller="Accounts" asp-action="Logout" class="btn btn-primary btn-sm w-100">
                            <i class="fa-solid fa-right-from-bracket me-1"></i> Sign Out
                        </a>
                    </li>
                </ul>
            </li>

        </ul>

    </div>
</nav>
<!--end::Header-->
