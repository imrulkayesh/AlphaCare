@using Microsoft.AspNetCore.Http
@{
    var username = Context.Session.GetString("USERNAME") ?? "Guest";
    var showroomCode = Context.Session.GetString("EMPLOYEE_CODE") ?? "N/A";

    // Avatar initials, e.g. "Pavel Rahman" -> "PR"
    var parts = username.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = parts.Length >= 2
        ? $"{parts[0][0]}{parts[^1][0]}".ToUpper()
        : (username.Length >= 2 ? username.Substring(0, 2).ToUpper() : username.ToUpper());
}

<!--end::Header-->

<header class="top">
    <button class="icon-btn menu-btn" id="menuBtn" aria-label="Menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
    </button>

    <div class="title">
        <h2><span class="live">Alpha Care</span></h2>
    </div>

    <div class="spacer"></div>

    <div class="user">
        <div class="avatar">@initials</div>
        <div>
            <b>@username</b>
            <small>Showroom: @showroomCode<br>Dhaka</small>
        </div>
    </div>

    <a asp-area="" asp-controller="Accounts" asp-action="Logout" class="logout">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" /></svg>
        Log Out
    </a>
</header>
<style>
    header.top {
        padding: 4px 18px !important;
    }
</style>