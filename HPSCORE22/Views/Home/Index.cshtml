<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
    // ===== Responsive helpers (layout only - your data/ajax code below is unchanged) =====
    function isPhone() { return window.innerWidth < 640; }
    function wrapLabel(text, max) {            // "Chiller Plant / Cold Storage" -> ["Chiller Plant /", "Cold Storage"]
        var words = String(text).split(/\s+/), lines = [], line = '';
        words.forEach(function (w) {
            if (line && (line + ' ' + w).length > max) { lines.push(line); line = w; }
            else { line = line ? line + ' ' + w : w; }
        });
        if (line) lines.push(line);
        return lines;
    }

    // Problem-type bar chart: vertical on wide cards, horizontal on narrow cards
    var problemRows = [], problemHorizontal = null;
    function drawProblemChart() {
        var canvas = document.getElementById('barChart');
        if (!canvas || problemRows.length === 0) return;
        var box = canvas.parentElement;
        var horizontal = box.clientWidth < 560;
        problemHorizontal = horizontal;
        box.style.height = horizontal ? Math.max(240, problemRows.length * 56 + 30) + 'px' : '';

        var fullLabels = problemRows.map(function (r) { return r.label; });
        var labels = fullLabels.map(function (l) { return wrapLabel(l, horizontal ? 20 : 14); });

        if (window.problemTypeChart) window.problemTypeChart.destroy();
        window.problemTypeChart = new Chart(canvas.getContext('2d'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    { label: 'Current Month', data: problemRows.map(function (r) { return r.cur; }), backgroundColor: '#2563eb', borderRadius: 4 },
                    { label: 'Previous Month', data: problemRows.map(function (r) { return r.prev; }), backgroundColor: '#cbd5e1', borderRadius: 4 }
                ]
            },
            options: {
                indexAxis: horizontal ? 'y' : 'x',
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                datasets: { bar: { grouped: true, barPercentage: 0.85, categoryPercentage: 0.75 } },
                plugins: {
                    legend: { display: false },   // the card already has a custom legend
                    tooltip: { enabled: true, callbacks: { title: function (items) { return fullLabels[items[0].dataIndex]; } } }
                },
                scales: horizontal
                    ? { x: { beginAtZero: true, ticks: { precision: 0, font: { size: 11 } } },
                        y: { grid: { display: false }, ticks: { font: { size: 11 } } } }
                    : { x: { grid: { display: false }, ticks: { autoSkip: false, maxRotation: 0, minRotation: 0, font: { size: 11 } } },
                        y: { beginAtZero: true, ticks: { precision: 0, font: { size: 11 } } } }
            }
        });
    }
    // re-draw only when the card crosses the narrow/wide breakpoint (resize, rotate, sidebar collapse)
    (function () {
        var canvas = document.getElementById('barChart');
        if (!canvas || !window.ResizeObserver) return;
        new ResizeObserver(function () {
            if (problemRows.length === 0) return;
            if ((canvas.parentElement.clientWidth < 560) !== problemHorizontal) drawProblemChart();
        }).observe(canvas.parentElement);
    })();

    // Trend chart: hide axis titles + smaller points on phones
    window.addEventListener('resize', (function () {
        var t;
        return function () {
            clearTimeout(t);
            t = setTimeout(function () {
                var c = window.ticketTrendChart; if (!c) return;
                var phone = isPhone();
                c.options.scales.x.title.display = !phone;
                c.options.scales.y.title.display = !phone;
                c.data.datasets.forEach(function (d) { d.pointRadius = phone ? 2 : 3; });
                c.update('none');
            }, 150);
        };
    })());

    // Over Due popup close
    function closeDetails() {
        document.getElementById('detailsOverlay').style.display = 'none';
        document.body.style.overflow = '';
    }
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeDetails(); });

    $(document).ready(function () {
        $.ajax({
        url: '@Url.Action("GetProductWiseProductModel", "Home")',
        type: 'GET',

        success: function (data) {

            console.log(data);

            $('#Currentmonthtotal').text(data.Singlecard.CurrentMonthCount);
            $('#currenttotal').text(data.Singlecard.TodayCount);
            $('#CurrentMonthPending').text(data.Singlecard.PendingFeedbackCount);
            $('#Overdue').text(data.Singlecard.OldPendingCount);
            $('#currentavrg').text(data.Singlecard.CANCLE_FEEDBACK_COUNT);

            // =====================================
            // SLA Growth (Month over Month)
            // =====================================

            var thisMonth = Number(data.VsCardDetasil.THIS_MONTH_SOLVED_PERCENTAGE || 0);
            var lastMonth = Number(data.VsCardDetasil.LAST_MONTH_SOLVED_PERCENTAGE || 0);
            var growth = Number(data.VsCardDetasil.SOLVE_GROWTH_PERCENTAGE || 0);

            $('#CurrentMonthSLA').text(thisMonth + "%");
            $('#LastMonthSLA').text(lastMonth + "%");

            // Update percentage only
            $('#SolveGrowthValue').text(growth + "%");

            if (thisMonth > lastMonth) {

                $('#growthwork')
                    .removeClass('bg-warningcolor')
                    .addClass('bg-SolveGrowthSLA');

                $('#uparrow, #Upinfo').show();
                $('#downarrow, #downinfo').hide();

            }
            else {

                $('#growthwork')
                    .removeClass('bg-SolveGrowthSLA')
                    .addClass('bg-warningcolor');

                $('#downarrow, #downinfo').show();
                $('#uparrow, #Upinfo').hide();
            }

            $('#TotalTechnician').text(data.VsCardDetasil.ACTIVE_TECHNICIAN_COUNT);

        },

