                    }
                }
            });
        },

        error: function (xhr, status, error) {
            console.error('Error fetching Current Time Trend:', error);
            console.error(xhr.responseText);
        }
    });

    // Converts "/Date(1730419200000)/", ISO strings, or "2026-11-01" into "01 Nov"
    function formatDate(value) {
        if (!value) return '';

        var d;
        if (typeof value === 'string' && value.indexOf('/Date(') === 0) {
            d = new Date(parseInt(value.replace(/\D/g, '')));   // old MVC JSON date format
        } else {
            d = new Date(value);
        }

        if (isNaN(d.getTime())) return String(value);   // fall back to the raw value

        return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' });
    }
