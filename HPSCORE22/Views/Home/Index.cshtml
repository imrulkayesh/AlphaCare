                        </div>
                        <div class="icon">
                            <i class="fas fa-chart-line"></i>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-6">
                    <div class="kpi-box bg-TotalTechnician">
                        <div class="inner">
                            <h4 id="TotalTechnician">0</h4>
                            <p>Total Technicians</p>
                        </div>
                        <div class="icon">
                            <i class="fas fa-user-cog"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row g-3 mb-3 mt-2">
                <div class="col-md-6 col-sm-12">
                    <div class="card card-danger" style="width: 100%;">
                        <div class="card-header" style="height: 28px;text-align: center;padding: 1%;">
                            <h3 class="card-title" style="font-size: 14px;">Most Frequent Problem Type – Current Month</h3>
                        </div>
                        <div class="card-body" style="margin-top: 5%;">
                            <canvas id="barChart" style="min-height: 250px; height: 250px; max-height: 250px; max-width: 100%;"></canvas>
                        </div>
                        <!-- /.card-body -->
                    </div>
                </div>
               <div class="col-md-6 col-sm-12">
                    <div class="card card-danger">
                        <div class="card-header" style="height: 28px;text-align: center;padding: 1%;">
                            <h3 class="card-title" style="font-size: 14px;">
