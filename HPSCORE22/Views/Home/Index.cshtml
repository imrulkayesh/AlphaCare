    <!--Top Cards Box End-->
    <!-- PROBLEM TYPES + DONUT start-->
    <section class="two">
        <div class="card">
            <div class="ch-head">
                <div>
                    <h3>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round"><path d="M3 21h18M5 21V10M10 21V4M15 21V14M20 21V8" /></svg>
