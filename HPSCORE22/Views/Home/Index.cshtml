        $.ajax({
        url: '@Url.Action("GetCurrentDayStatus", "Home")',
        type: 'GET',
        success: function (data) {
            console.log("Current Day Ticket Status:", data);

            var card = data.Singlecard || data.singlecard || {};

            var solve   = Number(card.TotalSolve    ?? card.totalSolve    ?? 0);
            var unsolve = Number(card.TotalUnsolved ?? card.totalUnsolved ?? 0);
            var cancel  = Number(card.ToalCancelled ?? card.TotalCancelled ??
                                 card.toalCancelled ?? card.totalCancelled ?? 0);

            var total = solve + unsolve + cancel;
            var pct = function (v) { return total > 0 ? (v / total * 100).toFixed(1) : '0.0'; };

            // ---- Update legend text ----
            $('#totalBadge').text(total + ' Total');
            $('#solveCount').text(solve);
            $('#unsolveCount').text(unsolve);
            $('#cancelCount').text(cancel);
            $('#solvePct').text('(' + pct(solve) + '%)');
            $('#unsolvePct').text('(' + pct(unsolve) + '%)');
            $('#cancelPct').text('(' + pct(cancel) + '%)');

            // ---- Chart ----
            var ctx = document.getElementById('donut').getContext('2d');

            // Destroy previous chart if it exists
            if (window.ticketStatusChart) {
                window.ticketStatusChart.destroy();
            }

            window.ticketStatusChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Solved', 'Unsolved', 'Cancelled'],
                    datasets: [{
                        data: total > 0 ? [solve, unsolve, cancel] : [1],   // grey ring when empty
                        backgroundColor: total > 0
                            ? ['#10b981', '#f59e0b', '#ef4444']
                            : ['#f1f5f9'],
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '65%',                 // donut thickness
                    plugins: {
                        legend: { display: false }, // custom HTML legend is used instead
                        tooltip: { enabled: total > 0 }
                    }
                }
            });
        },
        error: function (xhr, status, error) {
            console.error('Error fetching Current Day Ticket Status:', error);
            console.error(xhr.responseText);
        }
    });
        $.ajax({
        url: '@Url.Action("GetCurrentTimeTrand", "Home")',
        type: 'GET',

        success: function (data) {
            console.log("Current Time Trend:", data);

            // Handles PascalCase and camelCase JSON
            var trendData = data.TimeTrendData || data.timeTrendData;

            if (!trendData || trendData.length === 0) {
                console.log("No trend data found.");
                return;
            }

            var labels = [];
            var totalComplain = [];
            var totalSolve = [];

            $.each(trendData, function (index, item) {
                var rawDate = item.ReportedDate ?? item.reportedDate;
                labels.push(formatDate(rawDate));

                totalComplain.push(Number(item.TotalTickets ?? item.totalTickets ?? 0));
                totalSolve.push(Number(item.SolvedTickets ?? item.solvedTickets ?? 0));
            });

            // Destroy old chart if it already exists
            if (window.ticketTrendChart) {
                window.ticketTrendChart.destroy();
            }

            var ctx = document.getElementById('line-chart').getContext('2d');

            window.ticketTrendChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Total Complain (Registered)',
                            data: totalComplain,
                            borderColor: '#2563eb',
                            backgroundColor: 'rgba(37,99,235,0.10)',
                            borderWidth: 2,
                            fill: false,
                            tension: 0.3,
                            pointRadius: isPhone() ? 2 : 3,
                            pointHoverRadius: 6,
                            pointBackgroundColor: '#2563eb'
                        },
                        {
                            label: 'Total Solved',
                            data: totalSolve,
                            borderColor: '#10b981',
                            backgroundColor: 'rgba(16,185,129,0.10)',
                            borderWidth: 2,
                            fill: false,
                            tension: 0.3,
                            pointRadius: isPhone() ? 2 : 3,
                            pointHoverRadius: 6,
                            pointBackgroundColor: '#10b981'
                        }
                    ]
                },
                options: {
                    responsive: true,
