@model AlphaCare.Models.Dashboard_Model.UserDashboardViewModel

@{
    ViewData["Title"] = "Home Page";
}
@* CDN  Link Start *@
<script src='https://kit.fontawesome.com/a076d05399.js' crossorigin='anonymous'></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
@* CDN  Link End *@
<style>
        .kpi-box {
        min-height: 75px !important;
        border-radius: 12px;
        overflow: hidden;
        transition: all .3s ease;
        box-shadow: 0 3px 10px rgba(0,0,0,.08);
        position: relative;
    }

    .kpi-box:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 20px rgba(0,0,0,.15);
    }

    .kpi-box .inner {
        padding: 12px 15px;
    }

    .kpi-box h4 {
        font-size: 24px;
        font-weight: 700;
        margin: 0;
        color: #fff;
    }

    .kpi-box p {
        margin: 2px 0 0;
        font-size: 13px;
        color: rgba(255,255,255,.9);
        font-weight: 500;
    }

    /* Icon Watermark */
    .kpi-box .icon {
        position: absolute;
        right: 12px;
        top: 8px;
        font-size: 38px;
        opacity: .18;
        color: #fff;
    }
    /* card Backgroun-color  */
    .bg-currentmonthtotal
    {
        background-color: green;
    }
    .bg-currentday
    {
        background-color: cornflowerblue;
    }
    .bg-currentMonthPending
    {
        background-color: orange;
    }
    .bg-Overdue
    {
        background-color: red ;
	}
    .bg-Technicians
    {
        background-color: mediumpurple;
    }
    .bg-CurrentMonthSLA
    {
        background-color: #1400ff;
    }
    .bg-LastMonthSLA {
        background-color: rebeccapurple;
    }

    .bg-SolveGrowthSLA {
        background-color: green;
    }
    .bg-TotalTechnician
        {
        background-color: darkorange;
	}
    .bg-warningcolor
    {
        background-color: red;
    }
</style>
<!--begin::App Main-->
<main class="app-main">
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row g-3 mb-3 align-items-center">
                <div class="col-lg-3 col-md-4 col-6">
                    <div class="kpi-box bg-currentmonthtotal">
                        <div class="inner">
                            <h4 id="Currentmonthtotal">0</h4>
                            <p>Current Month – Total Tickets</p>
                        </div>
                        <div class="icon">
                            <i class="fas fa-briefcase"></i>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-6">
                    <div class="kpi-box bg-currentMonthPending">
                        <div class="inner">
                            <h4 id="CurrentMonthPending">0</h4>
                            <p>Current Month – Total Solved</p>
                        </div>
                        <div class="icon">
                            <i class="fas fa-business-time"></i>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-6">
                    <div class="kpi-box bg-currentday">
                        <div class="inner">
                            <h4 id="currenttotal">0</h4>
                            <p>Today Total Ticket</p>
                        </div>
                        <div class="icon">
                            <i class="fas fa-edit"></i>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-6">
                    <div class="kpi-box bg-Overdue" onclick="GetAllDetailsData(2)">
                        <div class="inner">
                            <h4 id="Overdue">0</h4>
                            <p>Over Due Ticket (3+ Days) </p>
                        </div>
                        <div class="icon">
                            <i class="fas fa-business-time"></i>
                        </div>
                    </div>
                </div>    
                <!--VS Cards-->
                <div class="col-lg-3 col-md-4 col-6">
                    <div class="kpi-box bg-CurrentMonthSLA">
                        <div class="inner">
                            <h4 id="CurrentMonthSLA">0</h4>
                            <p>Current Month Solved SLA</p>
                        </div>
                        <div class="icon">
                            <i class="fas fa-calendar-minus"></i>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-6">
                    <div class="kpi-box bg-LastMonthSLA">
                        <div class="inner">
                            <h4 id="LastMonthSLA">0</h4>
                            <p>Last Month Solved SLA</p>
                        </div>
                        <div class="icon">
                            <i class="fas fa-calendar-minus"></i>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-6">
                    <div class="kpi-box" id="growthwork">
                        <div class="inner">
                            <div class=""style="display:flex;gap:4%">
                                <h4 id="SolveGrowthSLA">0</h4>
                                <i class='fas fa-angle-double-down' style='font-size:24px; margin-top: 2%;' id="downarrow"></i>
                                <i class='fas fa-angle-double-up' style='font-size:24px; margin-top: 2%;' id="uparrow"></i>
                            </div>
