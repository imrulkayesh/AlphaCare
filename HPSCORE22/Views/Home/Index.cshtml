                    </div>
                    <div class="col-md-6 col-sm-12">
                        <div class="card card-danger">
                            <div class="card-header" style="height: 28px;text-align: center;padding: 1%;">
                                <h3 class="card-title" style="font-size: 14px;">Lowest 5 Technicians – Current Month</h3>
                            </div>
                            <div class="card-body">
                                <table id="locationTable" class="table table-hover align-middle" style="height: 354px;">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>SL</th>
                                            <th>Name</th>
                                            <th>StaffID</th>
                                            <th>Current Solved</th>
                                            <th>Previous Solved</th>
                                            <th>Solve Growth </th>
                                            <th>Solve Ratio </th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @{
                                            int j = 1;
                                            @foreach (var item in Model.Lowest10TechnicianList)
                                            {
                                                <tr>
                                                    <td>@j</td>
                                                    <td>@item.TECHNICIANNAME</td>
                                                    <td>@item.STAFFID</td>
                                                    <td>@item.CURRENT_MONTH_SOLVE</td>
                                                    <td>@item.PREVIOUS_MONTH_SOLVE</td>
                                                    <td>@item.SOLVE_GROWTH</td>
                                                    <td>@item.SOLVE_GROWTH_PERCENTAGE %</td>
                                                </tr>
                                                j++;
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <!-- /.card-body -->
                        </div>
                    </div>
                </div>
                <div class="row g-3 mb-3 mt-2">
                    <div class="col-md-6 col-sm-12">
                        <div class="card card-danger">
                            <div class="card-header" style="height: 28px;text-align: center;padding: 1%;">
                                <h3 class="card-title" style="font-size: 14px;">Top 5 Showroom – Current Month</h3>
                            </div>
                            <div class="card-body">
                                <table id="locationTable" class="table table-hover align-middle" style="height: 354px;">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>SL</th>
                                            <th>Code</th>
                                            <th>Name</th>
                                            <th>Total</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @{
                                            int k = 1;
                                            @foreach (var item in Model.Top5Showroom)
                                            {
                                                <tr>
                                                    <td>@k</td>
                                                    <td>@item.TECHNICIANNAME</td>
                                                    <td>@item.STAFFID</td>
                                                    <td>@item.CURRENT_MONTH_SOLVE</td>
                                                </tr>
                                                k++;
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <!-- /.card-body -->
                        </div>
                    </div>
                  @*   <div class="col-md-6 col-sm-12">
                        <div class="card card-danger">
                            <div class="card-header" style="height: 28px;text-align: center;padding: 1%;">
                                <h3 class="card-title" style="font-size: 14px;">Last 30 Days Problem & Service Analysis (Top Five)</h3>
                            </div>
                            <div class="card-body">
                                <table id="locationTable" class="table table-hover align-middle" style="height: 354px;">
                                    <thead class="table-dark">
