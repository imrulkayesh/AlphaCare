@model AlphaCare.Models.Dashboard_Model.UserDashboardViewModel

@{
    ViewData["Title"] = "Home Page";
}
@* CDN  Link Start *@
<script src='https://kit.fontawesome.com/a076d05399.js' crossorigin='anonymous'></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
@* CDN  Link End *@
<style>
    /* ============ Responsive dashboard styles (everything this page needs) ============ */
    .content {
        padding: 10px;
    }

    .dash {
        display: flex;
        flex-direction: column;
        gap: 24px;
        min-width: 0;
    }

        .dash > section {
            min-width: 0;
        }

        .dash .grid4 {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        .dash .two {
            grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
        }

        .dash .kpi2 {
            padding: 10px 16px;
        }

            .dash .kpi2 .body {
                min-width: 0;
            }

            .dash .kpi2 .val {
                flex-wrap: wrap;
                row-gap: 0;
            }

        .dash .card {
            min-width: 0;
        }

            .dash .card h3 {
                min-width: 0;
            }

        .dash .ch-head {
            flex-wrap: wrap;
        }

            .dash .ch-head > div:first-child {
                min-width: 0;
            }

        .dash .tbl-head {
            flex-wrap: wrap;
            gap: 4px 12px;
        }

        .dash .tbl-foot {
            flex-wrap: wrap;
            gap: 6px 16px;
        }

    /* chart boxes: Chart.js needs a wrapper with a height */
    .chart-box {
        position: relative;
        width: 100%;
        height: 260px;
        margin-top: 16px;
    }

        .chart-box.trend {
            height: 320px;
            margin-top: 8px;
        }

        .chart-box canvas, .donut canvas {
            display: block;
            max-width: 100%;
        }

    /* the two tables: side by side when each gets >= 540px, otherwise stacked */
    .tables-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 540px), 1fr));
        gap: 24px;
    }

    .dash .scroll-x {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .dash table.t-tech {
        min-width: 540px;
    }

    .dash table.t-shop {
        min-width: 420px;
    }

    /* Over Due popup */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 99999;
        background: rgba(15,23,42,.55);
        align-items: center;
        justify-content: center;
        padding: 12px;
    }

    .modal-box {
        background: #fff;
        border-radius: 12px;
        width: 100%;
        max-width: 1200px;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        box-shadow: 0 20px 60px rgba(0,0,0,.35);
    }

    .modal-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 12px 18px;
        border-bottom: 1px solid #e2e8f0;
    }

        .modal-head h5 {
            margin: 0;
            font-size: 16px;
            font-weight: 700;
        }

    .modal-close {
        flex: none;
        width: 36px;
        height: 36px;
        border: 0;
        background: none;
        font-size: 28px;
        line-height: 1;
        cursor: pointer;
        color: #475569;
        border-radius: 8px;
    }

        .modal-close:hover {
            background: #f1f5f9;
        }

    .modal-body {
        padding: 14px 18px;
        overflow: auto;
        -webkit-overflow-scrolling: touch;
    }

        .modal-body table {
            min-width: 900px;
        }

        .modal-body th, .modal-body td {
            white-space: nowrap;
            vertical-align: middle;
        }

            .modal-body td:nth-child(7) {
                white-space: normal;
                min-width: 220px;
            }

    /* <= 1320px : 2 KPI cards per row, chart sections stacked */
    @@media (max-width: 1320px) {
        .dash .grid4 {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .dash .two {
            grid-template-columns: minmax(0, 1fr);
        }
    }
    /* phones / small tablets */
    @@media (max-width: 767px) {
        .dash .kpi2 .body .d-md-flex {
            display: flex !important;
            flex-wrap: wrap;
            align-items: baseline;
            gap: 0 8px;
        }
    }

    @@media (max-width: 640px) {
        .dash {
            gap: 16px;
        }

            .dash .grid4 {
                grid-template-columns: minmax(0, 1fr);
            }

            .dash .card {
                padding: 16px;
            }

            .dash .tbl-card {
                padding: 0;
            }

            .dash .ch-head {
                flex-direction: column;
                gap: 10px;
            }

            .dash .legend {
                flex-wrap: wrap;
                gap: 6px 16px;
            }

            .dash .card-foot {
                flex-direction: column;
                align-items: flex-start;
                gap: 8px;
            }

            .dash .donut-wrap {
                flex-direction: column;
                gap: 20px;
            }

            .dash .dlegend {
                width: 100%;
                max-width: 300px;
            }

            .dash .tbl-head {
                padding: 16px 14px;
            }

        .chart-box {
            height: 240px;
        }

            .chart-box.trend {
                height: 260px;
            }

        .modal-overlay {
            padding: 8px;
        }

        .modal-box {
            max-height: 94vh;
        }

        .modal-head, .modal-body {
            padding: 12px;
        }
    }
</style>
<!--begin::App Main-->
