<!--Details-->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">
                    Tickets Details
                </h1>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">

                <div class="table-responsive">
                    <table id="complaindetails"
                           class="table table-bordered table-striped table-hover w-100">

                        <thead>
                            <tr>
                                <th>SL</th>
                                <th>Ticket ID</th>
                                <th>Showroom Code</th>
                                <th>Complain & Assign Date</th>
                                <th>Customer Name</th>
                                <th>Contact No</th>
                                <th>Customer Address</th>
                                <th>Product Name</th>
                                <th>Assign Person</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<script>
    $(document).ready(function () {
        $.ajax({
             url:'@Url.Action("GetProductWiseProductModel", "Home")',
            type: 'GET',
            success: function (data) {
                console.log(data);
                $('#Currentmonthtotal').text(data.Singlecard.CurrentMonthCount);
                $('#currenttotal').text(data.Singlecard.TodayCount);
                $('#CurrentMonthPending').text(data.Singlecard.PendingFeedbackCount);
                $('#Overdue').text(data.Singlecard.OldPendingCount);
               // Due Card
          if ((data.VsCardDetasil.THIS_MONTH_SOLVED_PERCENTAGE  -
         data.VsCardDetasil.LAST_MONTH_SOLVED_PERCENTAGE) > 0)
    {
        $('#growthwork')
            .removeClass('bg-warningcolor')
            .addClass('bg-SolveGrowthSLA');

        $('#uparrow').show();
        $('#downarrow').hide();
    }
    else
    {
        $('#growthwork')
            .removeClass('bg-SolveGrowthSLA')
            .addClass('bg-warningcolor');

        $('#downarrow').show();
        $('#uparrow').hide();
    }
                $('#CurrentMonthSLA').text(data.VsCardDetasil.THIS_MONTH_SOLVED_PERCENTAGE +"%");
                $('#LastMonthSLA').text(data.VsCardDetasil.LAST_MONTH_SOLVED_PERCENTAGE +"%");
                $('#SolveGrowthSLA').text(data.VsCardDetasil.SOLVE_GROWTH_PERCENTAGE +"%");
                $('#TotalTechnician').text(data.VsCardDetasil.ACTIVE_TECHNICIAN_COUNT);
            },
            error: function (xhr, status, error) {
                console.error('Error fetching dashboard data:', error);
            }
        });
        $.ajax({
        url: '@Url.Action("GetTop5ProblemType", "Home")',
        type: 'GET',

        success: function (data) {

            console.log("Top 5 Problem Type:", data);
           var problemTypeData = data.ProblemTypeData;
           console.log("Problem Type Data:", problemTypeData);
         if (!problemTypeData || problemTypeData.length === 0) {
            console.log("No problem type data found.");
            return;
          }
            var labels = [];
            var currentMonthValues = [];
            var previousMonthValues = [];

            $.each(problemTypeData, function (index, item) {

                // Problem Type name
                labels.push(item.CurrentMonthLabel);

                // Current month count
                currentMonthValues.push(item.CurrentMonthValue);

                // Previous month count
                previousMonthValues.push(item.PreviousMonthValue);
            });


            // ==========================================
            // Chart Data
            // ==========================================

            var barChartData = {

                labels: labels,

                datasets: [

                    {
                        label: 'Current Month',

                        backgroundColor: 'rgba(60,141,188,0.9)',
                        borderColor: 'rgba(60,141,188,0.8)',

                        borderWidth: 1,

                        data: currentMonthValues
                    },

                    {
                        label: 'Previous Month',

                        backgroundColor: 'rgba(210,214,222,1)',
                        borderColor: 'rgba(210,214,222,1)',

                        borderWidth: 1,

                        data: previousMonthValues
                    }

                ]
            };


            // ==========================================
            // Chart Options
            // ==========================================

               var barChartOptions = {

        responsive: true,

        maintainAspectRatio: false,

        scales: {

            y: {
                beginAtZero: true,

                ticks: {
                    precision: 0
                }
            }

        }

    };


            // ==========================================
            // Create Chart
            // ==========================================

            var barChartCanvas = $('#barChart')
                .get(0)
                .getContext('2d');


            new Chart(barChartCanvas, {

                type: 'bar',

                data: barChartData,

                options: barChartOptions

            });

        },

        error: function (xhr, status, error) {

            console.error(
                'Error fetching Top 5 Problem Type:',
                error
            );

            console.error(xhr.responseText);
        }
    });
        $.ajax({
        url: '@Url.Action("GetCurrentDayStatus", "Home")',
        type: 'GET',

        success: function (data) {

            console.log("Current Day Ticket Status:", data);

            // ==========================================
            // Dynamic Values
            // ==========================================

            var solve = Number(data.Singlecard.TotalSolve || 0);
            var unsolve = Number(data.Singlecard.TotalUnsolved || 0);
            var cancel = Number(data.Singlecard.ToalCancelled || 0);
            // ==========================================
            // Donut Chart
            // ==========================================
            var donutChartCanvas = $('#donutChart')
                .get(0)
                .getContext('2d');
            var donutData = {

                labels: [
                    'Solved',
                    'Unsolved',
                    'Cancelled'
                ],

                datasets: [
                    {
                        data: [
                            solve,
                            unsolve,
                            cancel
                        ],

                        backgroundColor: [
                            '#00a65a',
                            '#f39c12',
                            '#f56954'
                        ]
                    }
                ]
            };


          var donutOptions = {

        maintainAspectRatio: false,

        responsive: true,

        plugins: {

            legend: {
                display: true
            }

        }

    };


            // Destroy previous chart if it already exists
            if (window.ticketStatusChart) {
                window.ticketStatusChart.destroy();
            }


            window.ticketStatusChart = new Chart(
                donutChartCanvas,
                {
                    type: 'doughnut',
                    data: donutData,
                    options: donutOptions
                }
            );

        },

        error: function (xhr, status, error) {

            console.error(
                'Error fetching Current Day Ticket Status:',
                error
            );

            console.error(xhr.responseText);
        }
    });
        $.ajax({
        url: '@Url.Action("GetCurrentTimeTrand", "Home")',
        type: 'GET',

        success: function (data) {

            console.log("Current Time Trend:", data);

            var trendData = data.TimeTrendData;

            if (!trendData || trendData.length === 0) {
                console.log("No trend data found.");
                return;
            }

            var labels = [];
            var totalComplain = [];
            var totalSolve = [];

            $.each(trendData, function (index, item) {

                labels.push(item.ReportedDate);

                totalComplain.push(
                    Number(item.TotalTickets || 0)
                );

                totalSolve.push(
                    Number(item.SolvedTickets || 0)
                );

            });

            console.log("Labels:", labels);
            console.log("Total Complain:", totalComplain);
            console.log("Total Solve:", totalSolve);


            // Destroy old chart if already created
            if (window.ticketTrendChart) {
                window.ticketTrendChart.destroy();
            }


            var lineChartCanvas = document
                .getElementById('line-chart')
                .getContext('2d');


            window.ticketTrendChart = new Chart(
                lineChartCanvas,
                {
                    type: 'line',

                    data: {

                        labels: labels,

                        datasets: [

                            {
                                label: 'Total Complain',

                                data: totalComplain,

                                borderColor: '#3c8dbc',

                                backgroundColor: 'rgba(60,141,188,0.1)',

                                borderWidth: 2,

                                fill: false,

                                tension: 0.3,

                                pointRadius: 4,

                                pointHoverRadius: 6
                            },

                            {
                                label: 'Total Solve',

                                data: totalSolve,

                                borderColor: '#00a65a',

                                backgroundColor: 'rgba(0,166,90,0.1)',

                                borderWidth: 2,

                                fill: false,

                                tension: 0.3,

                                pointRadius: 4,

                                pointHoverRadius: 6
                            }

                        ]
                    },

                    options: {

                        responsive: true,

                        maintainAspectRatio: false,

                        interaction: {
                            mode: 'index',
                            intersect: false
                        },

                        plugins: {

                            legend: {
                                display: true,
                                position: 'top'
                            },

                            tooltip: {
                                enabled: true
                            }

                        },

                        scales: {

                            x: {
                                title: {
                                    display: true,
                                    text: 'Reported Date'
                                }
                            },

                            y: {
                                beginAtZero: true,

                                title: {
                                    display: true,
                                    text: 'Ticket Count'
                                },

                                ticks: {
                                    precision: 0
                                }
                            }

                        }

                    }

                }
            );

        },

        error: function (xhr, status, error) {

            console.error(
                'Error fetching Current Time Trend:',
                error
            );

            console.error(xhr.responseText);

        }
    });
	});
    // Function Method
       function GetAllDetailsData(TypeID) {

        $.ajax({
            url: '@Url.Action("GetDetailsData", "Home")',
            type: 'GET',
            data: {
                typeID: TypeID
            },

            success: function (data) {

                console.log("Details Data:", data);

                var tbody = $("#complaindetails tbody");

                // Clear previous data
                tbody.empty();


                // Check data
                if (data.PendingComplainList &&
                    data.PendingComplainList.length > 0) {

                    $.each(data.PendingComplainList, function (i, item) {

                        var row = `
                            <tr>
                                <td>${i + 1}</td>
                                <td>${item.TICKETCODE ?? 'N/A'}</td>
                                <td>${item.SHOWROOM ?? 'N/A'}</td>
                                <td>${item.COMPLAINDATE ?? 'N/A'}</td>
                                <td>${item.CUSTOMERNAME ?? 'N/A'}</td>
                                <td>${item.CONTACTNO ?? 'N/A'}</td>
                                <td>${item.LOCATION ?? 'N/A'}</td>
                                <td>${item.PRODUCTNAME ?? 'N/A'}</td>
                                <td>${item.TECHNICIANDETAILS ?? 'N/A'}</td>
                            </tr>
                        `;

                        tbody.append(row);
                    });

                }
                else {

                    tbody.append(`
                        <tr>
                            <td colspan="9" class="text-center">
                                No data found.
                            </td>
                        </tr>
                    `);
                }


                // ==========================================
                // Open Modal
                // ==========================================
                var modal = new bootstrap.Modal(
                    document.getElementById('exampleModal')
                );

                modal.show();

            },

            error: function (xhr, status, error) {

                console.error(
                    'Error fetching ticket details:',
                    error
                );

                console.error(xhr.responseText);
            }
        });
    }
</script>
