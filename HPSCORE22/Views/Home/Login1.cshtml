@{
    Layout = "_Loginlayout";
    ViewData["Title"] = "Login";
}

<div class="d-flex align-items-center justify-content-center min-vh-100 mailchimp-bg">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-sm-10">
                <!-- Card with image and login -->
                <div class="card shadow-sm overflow-hidden rounded-4">
                    <div class="row g-0">

                        <!-- LEFT IMAGE -->
                        <div class="col-md-6 d-none d-md-block">
                            <img src="~/assets/img/mmm.jpg"
                                 alt="Mailchimp"
                                 class="img-fluid h-100 w-100 login-img">
                        </div>

                        <!-- RIGHT LOGIN -->
                        <div class="col-md-6 col-sm-12">
                            <div class="card-body p-4">
                                <h2 class="mailchimp-logo text-center mb-4">Login</h2>

                                <form method="post">
                                    <div class="mb-3">
                                        <input class="form-control form-control-lg"
                                               placeholder="Username"
                                               required>
                                    </div>

                                    <div class="mb-3">
                                        <input type="password"
                                               class="form-control form-control-lg"
                                               placeholder="Password"
                                               required>
                                        <div class="d-flex justify-content-between mt-1">
                                            <div class="form-check small">
                                                <input class="form-check-input" type="checkbox">
                                                <label class="form-check-label">Show</label>
                                            </div>
                                            <a href="#" class="small text-danger">I forgot</a>
                                        </div>
                                    </div>

                                    <button class="btn btn-secondary w-100 py-2 mb-3">
                                        Log In
                                    </button>

                                    <div class="form-check small mb-3">
                                        <input class="form-check-input" type="checkbox">
                                        <label class="form-check-label">Stay Logged In</label>
                                    </div>

                                    <div class="text-center small">
                                        @* <a href="#" class="text-danger">Create an account</a>
                                        <span class="mx-1">|</span> *@
                                        <a href="#" class="text-danger">Trouble logging in?</a>
                                    </div>
                                </form>
                            </div>
                        </div>

                    </div>
                </div>
                <!-- End Card -->
            </div>
        </div>
    </div>
</div>

<style>
    /* Smooth zoom effect for the left image */
    .login-img {
        object-fit: cover;
        transition: transform 0.5s ease;
    }

        .login-img:hover {
            transform: scale(1.05);
        }
</style>
