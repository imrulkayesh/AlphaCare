<!-- JS -->
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<!--Data Table-->
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script>
    // Data table start
    $(document).ready(function () {
        $('#locationTable').DataTable({
            pageLength: 5,
            lengthMenu: [5, 10, 25, 50],
            ordering: true,
            searching: true,
            paging: true,
            info: true,
            autoWidth: false,
            responsive: true, // ✅ better UI

            language: {
                search: "🔍 Search:",
                lengthMenu: "Show _MENU_ entries",
                zeroRecords: "No matching locations found",
                info: "Showing _START_ to _END_ of _TOTAL_ locations",
                infoEmpty: "No data available"
            },

            columnDefs: [
                { orderable: false, targets: 5 } // action column
            ]
        });
    });
    function confirmDelete() {
        return confirm("⚠️ Are you sure you want to delete?");
    }
     // Data table End

     // Add Delete Problem Start
    document.addEventListener("click", function (e) {

        // ============================
        // Add Row
        // ============================
        if (e.target.classList.contains("addRow")) {

            let row = e.target.closest(".problem-row");

            // Get currently selected problem
            let currentSelect = row.querySelector("select");
            let selectedProblem = currentSelect.value;

            // Check if problem is selected
            if (!selectedProblem) {
                alert("Please select a problem first.");
                return;
            }

            // Clone current row
            let clone = row.cloneNode(true);

            // Clear values
            clone.querySelectorAll("input").forEach(function (input) {

                if (input.name.includes("QUANTITY")) {
                    input.value = 1;
                } else {
                    input.value = "";
                }

            });

            // Reset problem dropdown
            clone.querySelector("select").selectedIndex = 0;

            // Add cloned row
            document.getElementById("problemContainer").appendChild(clone);

            // Update indexes
            updateIndexes();
        }


        // ============================
        // Remove Row
        // ============================
        if (e.target.classList.contains("removeRow")) {

            let rows = document.querySelectorAll(".problem-row");

            if (rows.length > 1) {

                e.target.closest(".problem-row").remove();

                updateIndexes();
            }
        }

    });


    // ==========================================
    // Problem Change - Duplicate Check
    // ==========================================
    document.addEventListener("change", function (e) {

        if (e.target.classList.contains("problemList")) {

            let currentSelect = e.target;
            let selectedProblem = currentSelect.value;

            // Nothing selected
            if (!selectedProblem) {
                return;
            }

            let duplicate = false;

            // Check all problem dropdowns
            document.querySelectorAll(".problemList").forEach(function (select) {

                // Don't compare with itself
                if (select !== currentSelect &&
                    select.value === selectedProblem) {

                    duplicate = true;
                }

            });

            // Duplicate found
            if (duplicate) {

                alert("This problem has already been selected. Please select another problem.");

                // Reset current dropdown
                currentSelect.selectedIndex = 0;
            }
        }

    });


    // ==========================================
    // Update Model Binding Indexes
    // ==========================================
    function updateIndexes() {

        document.querySelectorAll(".problem-row").forEach(function (row, index) {

            row.querySelector("select").name =
                `ComplainProblemList[${index}].PROBLEMID`;

            row.querySelector("input[name*='QUANTITY']").name =
                `ComplainProblemList[${index}].QUANTITY`;

            row.querySelector("input[name*='REMARKS']").name =
                `ComplainProblemList[${index}].REMARKS`;
        });

    }
     // Add Delete Problem End

     // Dependable & Ajax Code start
       $(document).on('change', '#ProductName', function () {

             var zoneId = $(this).val();

             $.ajax({
                 url: '@Url.Action("GetProductWiseProductModel", "ComplainGeneration")',
                 type: 'GET',
                 data: { ProductID: zoneId },
                 dataType: 'json',
                 success: function (res) {
                      $("#technicansname").empty().append('<option value="">Select Technician</option>');
                     console.log(res);
                 var ddltech = $('#technicansname');
                     ddltech.empty();
                     ddltech.append('<option value="">Select Technican Name</option>');

                         $.each(res.TechniciansList, function (i, item) {

                             ddltech.append(
                                 '<option value="' + item.TECHNICIANID + '">' +
                                 item.TECHNICIANNAME +
                                 '</option>'
                             );
                         });
                  var ddltech = $('#problemlist');
                     ddltech.empty();
                     ddltech.append('<option value="">Select Problem Name</option>');
                     $.each(res.ProblemDataModel, function (i, item) {

                             ddltech.append(
                                 '<option value="' + item.PROBLEMID + '">' +
                                 item.PROBLEMNAME +
                                 '</option>'
                             );
                         });
                     document.getElementById("problemContainer").style.display = "block";
                 },
                 error: function (xhr) {
                     console.log(xhr.responseText);
                 }
             });
         });
    // Dependable & Ajax Code End
</script>