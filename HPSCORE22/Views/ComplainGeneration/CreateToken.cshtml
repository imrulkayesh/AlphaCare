<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script>
    // Data table start
    $(document).ready(function () {
        $('#locationTable').DataTable({
            pageLength: 5,
            lengthMenu: [5, 10, 25, 50],
            ordering: true,
            searching: true,
            paging: true,
            info: true,
            autoWidth: false,
            responsive: true, // ✅ better UI

            language: {
                search: "🔍 Search:",
                lengthMenu: "Show _MENU_ entries",
                zeroRecords: "No matching locations found",
                info: "Showing _START_ to _END_ of _TOTAL_ locations",
                infoEmpty: "No data available"
            },

            columnDefs: [
                { orderable: false, targets: 5 } // action column
            ]
        });
    });
    function confirmDelete() {
        return confirm("⚠️ Are you sure you want to delete?");
    }
     // Data table End

     // Add Delete Problem Start
    // ==========================================
    // Add / Delete Problem
    // ==========================================

    document.addEventListener("click", function (e) {

        // ==========================================
        // ADD ROW
        // ==========================================

        if (e.target.classList.contains("addRow")) {

            let row = e.target.closest(".problem-row");

            if (!row) {
                return;
            }

            // Current problem dropdown
            let currentSelect = row.querySelector(".problemList");

            if (!currentSelect) {
                console.error("Problem dropdown not found.");
                return;
            }

            let selectedProblem = currentSelect.value;

            // Problem must be selected
            if (!selectedProblem) {
                alert("Please select a problem first.");
                return;
            }

            // Clone row
            let clone = row.cloneNode(true);

            // ==========================================
            // Reset dropdown
            // ==========================================

            let clonedSelect = clone.querySelector(".problemList");

            if (clonedSelect) {
                clonedSelect.selectedIndex = 0;
            }

            // ==========================================
            // Reset inputs
            // ==========================================

            clone.querySelectorAll("input").forEach(function (input) {

                if (input.name.includes("QUANTITY")) {

                    input.value = 1;

                }
                else if (input.name.includes("REMARKS")) {

                    input.value = "";

                }

            });

            // ==========================================
            // Get container
            // ==========================================

            let problemContainer =
                document.getElementById("problemContainer");

            if (!problemContainer) {

                console.error(
                    "problemContainer element was not found."
                );

                return;
            }

            // ==========================================
            // Add cloned row
            // ==========================================

            problemContainer.appendChild(clone);

            // ==========================================
            // Update indexes
            // ==========================================

            updateIndexes();
        }


        // ==========================================
        // REMOVE ROW
        // ==========================================

        if (e.target.classList.contains("removeRow")) {

            let rows =
                document.querySelectorAll(".problem-row");

            // Keep at least one row
            if (rows.length > 1) {

                let row =
                    e.target.closest(".problem-row");

                if (row) {

                    row.remove();

                    updateIndexes();
                }
            }
        }

    });


    // ==========================================
    // DUPLICATE PROBLEM CHECK
    // ==========================================

    document.addEventListener("change", function (e) {

        if (!e.target.classList.contains("problemList")) {
            return;
        }

        let currentSelect = e.target;

        let selectedProblem = currentSelect.value;

        if (!selectedProblem) {
            return;
        }

        let duplicate = false;

        document.querySelectorAll(".problemList").forEach(function (select) {

            if (
                select !== currentSelect &&
                select.value === selectedProblem
            ) {
                duplicate = true;
            }

        });

        if (duplicate) {

            alert(
                "This problem has already been selected. Please select another problem."
            );

            currentSelect.selectedIndex = 0;
        }

    });


    // ==========================================
    // UPDATE MODEL BINDING INDEXES
    // ==========================================

    function updateIndexes() {

        document.querySelectorAll(".problem-row")
            .forEach(function (row, index) {

                let select =
                    row.querySelector(".problemList");

                let quantity =
                    row.querySelector("input[name*='QUANTITY']");

                let remarks =
                    row.querySelector("input[name*='REMARKS']");


                if (select) {

                    select.name =
                        `ProblemListAdded[${index}].PROBLEMID`;
                }


                if (quantity) {

                    quantity.name =
                        `ProblemListAdded[${index}].QUANTITY`;
                }


                if (remarks) {

                    remarks.name =
                        `ProblemListAdded[${index}].REMARKS`;
                }

            });
    }
     // Add Delete Problem End

