           // ==========================================
    // Dependent Dropdown & AJAX Code
    // ==========================================

    $(document).on('change', '#ProductName', function () {

        var productId = $(this).val();

        // ==========================================
        // If no product selected
        // ==========================================

        if (!productId) {

            $('#technicansname')
                .empty()
                .append('<option value="">Select Technician</option>');

            $('.problemList')
                .empty()
                .append('<option value="">Select Problem Name</option>');

            return;
        }


        // ==========================================
        // AJAX Request
        // ==========================================

        $.ajax({

            url: '@Url.Action("GetProductWiseProductModel", "ComplainGeneration")',

            type: 'GET',

            data: {
                ProductID: productId
            },

            dataType: 'json',

            beforeSend: function () {

                console.log("Loading data for ProductID:", productId);

                // Disable dropdowns while loading
                $('#technicansname').prop('disabled', true);

                $('.problemList').prop('disabled', true);
            },

            success: function (res) {

                console.log("AJAX Response:", res);


                // ==========================================
                // Technician Dropdown
                // ==========================================

                var ddlTechnician =
                    $('#technicansname');


                // Clear existing technicians
                ddlTechnician.empty();


                // Default option
                ddlTechnician.append(
                    $('<option>', {
                        value: '',
                        text: 'Select Technician'
                    })
                );


                // Check technician data
                if (
                    res &&
                    res.TechniciansList &&
                    res.TechniciansList.length > 0
                ) {

                    $.each(
                        res.TechniciansList,
                        function (i, item) {

                            ddlTechnician.append(
                                $('<option>', {
                                    value: item.TECHNICIANID,
                                    text: item.TECHNICIANNAME
                                })
                            );

                        }
                    );

                }
                else {

                    console.log(
                        "No technician found for this product."
                    );

                }


                // ==========================================
                // Problem Dropdown
                // ==========================================

                var problemDropdown =
                    $('.problemList').first();


                // Clear existing problem options
                problemDropdown.empty();


                // Default option
                problemDropdown.append(
                    $('<option>', {
                        value: '',
                        text: 'Select Problem Name'
                    })
                );


                // Check problem data
                if (
                    res &&
                    res.ProblemDataModel &&
                    res.ProblemDataModel.length > 0
                ) {

                    $.each(
                        res.ProblemDataModel,
                        function (i, item) {

                            problemDropdown.append(
                                $('<option>', {
                                    value: item.PROBLEMID,
                                    text: item.PROBLEMNAME
                                })
                            );

                        }
                    );

                }
                else {

                    console.log(
                        "No problem found for this product."
                    );

                }


                // ==========================================
                // Enable dropdowns
                // ==========================================

                ddlTechnician.prop('disabled', false);

                $('.problemList').prop('disabled', false);


                // ==========================================
                // Show Problem Container
                // ==========================================

                var problemContainer =
                    document.getElementById("problemContainer");


                if (problemContainer) {

                    problemContainer.style.display = "block";

                }
                else {

                    console.error(
                        "problemContainer element not found."
                    );

                }


                // ==========================================
                // Update Model Binding Index
                // ==========================================

                if (typeof updateIndexes === "function") {

                    updateIndexes();

                }

            },

            error: function (xhr, status, error) {

                console.error(
                    "AJAX Error:",
                    error
                );

                console.error(
                    "Status:",
                    status
                );

                console.error(
                    "Response:",
                    xhr.responseText
                );


                // Reset Technician
                $('#technicansname')
                    .empty()
                    .append(
                        '<option value="">Select Technician</option>'
                    );


                // Reset Problem
                $('.problemList')
                    .empty()
                    .append(
                        '<option value="">Select Problem Name</option>'
                    );


                // Enable dropdowns
                $('#technicansname')
                    .prop('disabled', false);

                $('.problemList')
                    .prop('disabled', false);


                alert(
                    "Unable to load technician and problem information."
                );

            }

        });

    });
    // Dependable & Ajax Code End
</script>