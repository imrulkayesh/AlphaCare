@model RetailCare.Models.CRMViewModel.ComplainGenerationViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- ADD JQUERY -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css"
      rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

<div class="row mt-3">
    <div class="card">
        <div class="top-border"></div>
        <div class="card-header entryfromheader">
            <h3 class="card-title">Generate & Assign Ticket List</h3>
        </div>
        <div class="card-body">
            <table id="locationTable" class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>SL</th>
                        <th>Ticket ID</th>
                        <th>Complain Date</th>
                        <th>Customer Name</th>
                        <th>Contact No</th>
                        <th>Location</th>
                        <th>Product Name</th>
                        <th>Technician Name</th>
                        <th>Problem Details</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        int i = 1;
                        @foreach (var item in Model.ComplainList)
                        {
                            <tr>
                                <td>@i</td>
                                <td>@item.TICKETCODE</td>
                                <td>@item.COMPLAINDATE?.ToString("dd/MM/yyyy")</td>
                                <td>@item.CUSTOMERNAME</td>
                                <td>@item.CONTACTNO</td>
                                <td>@item.LOCATION</td>
                                <td>@item.PRODUCTNAME</td>
                                <td>@item.TECHNICIANNAME</td>
                                <td class="text-center">
                                    <button type="button"
                                            class="btn btn-primary btn-sm assign-btn"
                                            data-bs-toggle="modal"
                                            data-bs-target="#exampleModal" onclick="ProblemDetails('@item.TICKETCODE')">
                                        <i class="fa fa-plus-circle"></i>
                                    </button>
                                </td>
                                <td class="text-center">
                                    <a asp-action="EditCompplain"
                                       asp-controller="ComplainGeneration"
                                       asp-route-id="@item.TICKETID"
                                       class="btn btn-primary btn-sm assign-btn">
                                        <i class="fas fa-arrow-alt-circle-right"></i>
                                    </a>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Problem Details</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table id="complaindetails" class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>SL</th>
                            <th>Problem Name</th>
                            <th>Quantity</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<!-- JS -->
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<!--Data Table-->
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script>
    // Data table start
    $(document).ready(function () {
        $('#locationTable').DataTable({
            pageLength: 5,
            lengthMenu: [5, 10, 25, 50],
            ordering: true,
            searching: true,
            paging: true,
            info: true,
            autoWidth: false,
            responsive: true, // ✅ better UI

            language: {
                search: "🔍 Search:",
                lengthMenu: "Show _MENU_ entries",
                zeroRecords: "No matching locations found",
                info: "Showing _START_ to _END_ of _TOTAL_ locations",
                infoEmpty: "No data available"
            },

            columnDefs: [
                { orderable: false, targets: 5 } // action column
            ]
        });
    });
    function confirmDelete() {
        return confirm("⚠️ Are you sure you want to delete?");
    }
     // Data table End

     // Add Delete Problem Start
      document.addEventListener("click", function (e) {

        // Add row
        if (e.target.classList.contains("addRow")) {

            let row = e.target.closest(".problem-row");
            let clone = row.cloneNode(true);

            clone.querySelectorAll("input").forEach(x => x.value = "");
            clone.querySelector("select").selectedIndex = 0;

            document.getElementById("problemContainer").appendChild(clone);
        }

        // Remove row
        if (e.target.classList.contains("removeRow")) {

            let rows = document.querySelectorAll(".problem-row");

            if (rows.length > 1) {
                e.target.closest(".problem-row").remove();
            }
        }

    });
     // Add Delete Problem End

     // Dependable & Ajax Code start
       function ProblemDetails(ticketcode) {

        $.ajax({
            url: '@Url.Action("GetAllComplainProblemList", "ComplainGeneration")',
            type: 'GET',
            data: { ticketcode: ticketcode },
            dataType: 'json',
            success: function (res) {

                console.log(res);

                var tbody = $("#complaindetails tbody");
                tbody.empty();

                if (res.ProblemList && res.ProblemList.length > 0) {

                    $.each(res.ProblemList, function (i, item) {

                        var row = `
                            <tr>
                                <td>${i + 1}</td>
                                <td>${item.PROBLEMNAME}</td>
                                <td>${item.QUANTITY}</td>
                               <td>${item.REMARKS ?? 'N/A'}</td>
                            </tr>`;

                        tbody.append(row);
                    });

                } else {

                    tbody.append(`
                        <tr>
                            <td colspan="4" class="text-center">
                                No data found.
                            </td>
                        </tr>
                    `);
                }
            },
            error: function (xhr) {
                console.log(xhr.responseText);
            }
        });
    }
    // Dependable & Ajax Code End
</script>