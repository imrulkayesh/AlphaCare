@model List<RetailCare.Models.CompanyModel>
@{
    Layout = "~/Views/Shared/_SelectCompany.cshtml";
}

<div class="card login-card border-0 mb-4">

    <!-- Gradient hero -->
    <div class="card-hero position-relative">
 @*        <div class="d-flex flex-wrap gap-2 mb-3">
           <span class="pill-verified">AUTHENTICATION VERIFIED</span>
            <span class="pill-assign">Operational Workspace Assignment</span>
        </div> *@
        <h1 class="hero-title">Welcome To Alpha Care, @ViewBag.Name</h1>
    </div>

    <!-- Form body -->
    <div class="card-body p-4" style="padding: 4%;">

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3" style="padding: 2%;">
            <label for="companySelect" class="form-label mb-0 fs-6 fw-medium">
                Please Select Operating Company <span class="text-danger">*</span>
            </label>
        </div>
        @using (Html.BeginForm("UserDashboardDirection", "Accounts", FormMethod.Post, new { @class = "form-inline" }))
        {
            <select id="companySelect" class="form-select form-select-lg company-select" style="padding:1%;">
                <option selected>Please Select Company</option>
                @foreach (var company in Model)
                {
                    <option value="@company.COMPANYID">@company.COMPANYNAME</option>
                }
            </select>

            <!-- Actions -->
            <div class="d-flex justify-content-between align-items-center mt-2" style="float:right;padding: 2%;">
                <button type="submit" id="proceedBtn" class="btn btn-proceed" style="background-color: green;">
                    Proceed to Portal <i class="bi bi-arrow-right ms-2"></i>
                </button>
            </div>
        }
    </div>
</div>

<style>
    .content
    {
        width: 40% !important;
    }

    .card-hero {
        min-height: 92px !important;
    }
    .hero-title {
        font-size: 1.5rem !important;
    }
    .main {
        margin-left: 0px !important;
    }

    .sso-alert {
        background: #fffbeb;
        border: 1px solid #fde9a8;
        border-radius: 12px;
        padding: 14px 20px;
        font-size: .9rem;
    }

    .tls-badge {
        font-family: 'JetBrains Mono', monospace;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .5px;
        color: #047857;
        background: #d1fae5;
        border: 1px solid #a7f3d0;
        padding: 4px 10px;
        border-radius: 6px;
    }

    /* ============ Card ============ */
    .login-card {
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 6px 24px rgba(17, 24, 39, .08);
        border: 1px solid var(--border) !important;
    }

    .card-hero {
        background: linear-gradient(120deg, #f59e0b 0%, #f59e0b 45%, #f97316 100%);
        padding: 30px;
        min-height: 190px;
    }

    .pill-verified {
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .3px;
        color: #1f2937;
        background: rgba(180, 100, 10, .35);
        border: 1px solid rgba(120, 60, 0, .4);
        padding: 4px 14px;
        border-radius: 999px;
    }

    .pill-assign {
        font-size: .85rem;
        font-weight: 500;
        color: #1f2937;
        background: rgba(255, 255, 255, .3);
        padding: 4px 10px;
        border-radius: 6px;
    }

    .hero-title {
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -.8px;
        color: #111;
        margin-bottom: .6rem;
    }

    .hero-text {
        max-width: 640px;
        color: #1f2937;
        font-size: 1.05rem;
        line-height: 1.5;
    }

    .id-box {
        position: absolute;
        top: 30px;
        right: 30px;
        width: 60px;
        height: 60px;
        border-radius: 14px;
        background: rgba(180, 80, 10, .35);
        border: 1px solid rgba(120, 50, 0, .3);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        line-height: 1.1;
        color: #111;
    }

        .id-box small {
            font-size: .65rem;
            opacity: .7;
        }

        .id-box span {
            font-weight: 800;
            font-size: 1.05rem;
            letter-spacing: -.5px;
        }

    /* ============ Form ============ */
    .chip {
        font-size: .8rem;
        padding: 4px 11px;
        border-radius: 6px;
        border: 1px solid var(--border);
    }

    .chip-green {
        color: var(--green-dark);
        background: var(--green-soft);
        border-color: #b7ebd1;
    }

    .chip-gray {
        color: var(--muted);
        background: #f5f6f8;
    }

    .company-select {
        border-radius: 14px;
        border: 1px solid #cfd6e0;
        padding: 16px 20px;
        font-size: 1.05rem;
        background-color: #f9fafc;
    }

        .company-select:focus {
            border-color: var(--green);
            box-shadow: 0 0 0 .22rem rgba(15, 157, 110, .15);
        }

    .section-label {
        font-size: .82rem;
        font-weight: 600;
        letter-spacing: .8px;
        color: #4b5563;
    }

    .entity-card {
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 16px;
        background: #fafbfd;
        cursor: pointer;
        transition: all .15s ease;
        height: 100%;
    }

        .entity-card:hover {
            border-color: var(--green);
            background: #fff;
            transform: translateY(-2px);
            box-shadow: 0 6px 14px rgba(0,0,0,.06);
        }

        .entity-card.active {
            border-color: var(--green);
            background: var(--green-soft);
        }

        .entity-card strong {
            font-size: .95rem;
            font-weight: 600;
        }

        .entity-card small {
            display: block;
            margin-top: 6px;
            font-size: .88rem;
        }

    .entity-code {
        font-size: .68rem;
        font-weight: 700;
        background: #eceff4;
        color: #4b5563;
        padding: 3px 8px;
        border-radius: 5px;
    }

    .btn-proceed {
        background: var(--green-dark);
        color: #fff;
        font-weight: 600;
        font-size: 1.05rem;
        padding: 11px 30px;
        border-radius: 10px;
        box-shadow: 0 6px 14px rgba(5, 122, 85, .3);
    }

        .btn-proceed:hover {
            background: #046c4a;
            color: #fff;
        }

    .card-footer-bar {
        background: #f9fafb;
        border-top: 1px solid var(--border);
    }

    .support-link {
        font-size: .82rem;
        font-weight: 600;
        color: var(--green-dark);
        text-decoration: none;
    }

        .support-link:hover {
            text-decoration: underline;
        }

    /* ============ Stats ============ */
    .stat-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 20px;
        text-align: center;
        box-shadow: 0 2px 6px rgba(17, 24, 39, .03);
    }

    .stat-num {
        font-size: 1.6rem;
        font-weight: 600;
        line-height: 1.2;
    }

    .stat-label {
        font-size: .85rem;
        color: var(--muted);
    }

    /* ============ Footer ============ */
    .dot-sep {
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: #cbd2dc;
        display: inline-block;
    }

    /* ============ Responsive ============ */
    @@media (max-width: 576px) {
        .hero-title

    {
        font-size: 1.5rem;
    }

    .id-box {
        display: none;
    }

    .card-hero {
        padding: 22px;
    }

    }
</style>