@model RetailCare.Models.ReportGenerationViewModel
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
}
<partial name="~/Views/PartialView/_DataTableCSS.cshtml" />

<div class="card">
    <div class="top-border"></div>
    <div class="card-header entryfromheader">
        <h3 class="card-title"> Generated Complain List</h3>
    </div>
    <div class="card-body">

        @using (Html.BeginForm("ComplainReport", "ReportGeneration", FormMethod.Post, new { @class = "form-inline" }))
        {
            <div class="row" style="padding: 1%;margin-left: 7%;">
                <div class="col-md-3 col-sm-12">
                   <span style="color:red">*</span>
                    
                    @Html.ValidationMessageFor(model => model.FilteringOption.StartDate, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-3 col-sm-12">
                    @Html.LabelFor(model => model.FilteringOption.EndDate, new { @class = "control-label" })<span style="color:red">*</span>
                    @Html.TextBoxFor(model => model.FilteringOption.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    @Html.ValidationMessageFor(model => model.FilteringOption.EndDate, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-3 col-sm-12">
                    @Html.LabelFor(m => m.FilteringOption.StatusID, htmlAttributes: new { @class = "form-control-label" })
                 
                </div>
                <div class="col-md-3 col-sm-12 mt-3">
                    <button class="btn btn-success" type="submit">Show</button>
                </div>
            </div>
        }
       
        @if (Model.ComplainList.Count>0)
        {
            <div class="row">
                <div class="col-sm-12">
                    <table id="locationTable" class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>SL</th>
                                <th>Ticket ID</th>
                                <th>Customer Name</th>
                                <th>Contact No</th>
                                <th>Customer Address</th>
                                <th>Product Name</th>
                                <th>Problem Name</th>
                                <th>Assign Person</th>
                                <th>Assign Person StaffID</th>
                                <th>Status Name</th>
                                <th>Complain Date</th>
                                <th>Assign Date</th>
                                <th>Working Date</th>
                                <th>Complete Difference (Days)</th>
                                <th>Pending Difference (Days)</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                int i = 1;
                                @foreach (var item in Model.ComplainList)
                                {
                                    <tr>
                                        <td>@i</td>
                                        <td>@item.TICKETCODE</td>
                                        <td>@item.CUSTOMERNAME</td>
                                        <td>@item.CONTACTNO</td>
                                        <td>@item.LOCATION</td>
                                        <td>@item.PRODUCTNAME</td>
                                        <td>@item.PROBLEMNAME</td>
                                        <td>@item.TECHNICIANNAME</td>
                                        <td>@item.STAFFID</td>
                                        <td>@item.STATUSNAME</td>
                                        <td>@item.COMPLAINDATE?.ToString("dd/MM/yyyy")</td>
                                        <td>@item.ASSIGNDATE?.ToString("dd/MM/yyyy")</td>
                                        <td>@item.WORKINGDATE?.ToString("dd/MM/yyyy")</td>
                                        <td>@item.CompletedDiff</td>
                                        <td>@item.PendingDate</td>
                                    </tr>
                                    i++;
                                }
                            }
                        </tbody>

                    </table>
                </div>
            </div>
        }
        else
        {
            
        }


    </div>
</div>

<!-- Filters -->
<section class="panel p-3">
    <div class="row g-3 align-items-end">
        <div class="col-12 col-xl">
            @using (Html.BeginForm("ComplainReport", "ReportGeneration", FormMethod.Post, new { @class = "form-inline" }))
            {
                <div class="row g-2 align-items-end">
                     <!-- FROM DATE -->
                    <div class="col-12 col-sm-6 col-xl-auto">
                            <label class="control-label mb-1">
                                <i class="bi bi-calendar3 me-1"></i> FROM
                            </label>
                            @Html.TextBoxFor(
                            m => m.FilteringOption.StartDate,
                                            "{0:yyyy-MM-dd}",
                                            new { @class = "form-control", type = "date" }
                                            )
                    </div>
                    <!-- TO DATE -->
                    <div class="col-12 col-sm-6 col-xl-auto">
                        <label class="control-label mb-1">
                            <i class="bi bi-calendar3 me-1"></i> TO
                        </label>
                        @Html.TextBoxFor(
                                            m => m.FilteringOption.EndDate,
                                            "{0:yyyy-MM-dd}",
                                            new { @class = "form-control", type = "date" }
                                            )
                    </div>
                    <!-- STATUS -->
                    <div class="col-12 col-md-8 col-xl-auto">
                        <label class="control-label mb-1">STATUS</label>
                        @Html.DropDownListFor(
                                            m => m.FilteringOption.StatusID,
                                            new SelectList(Model.StatusList, "STATUSID", "STATUSNAME"),
                                            "All Statuses",
                                            new { @class = "form-select", style = "min-width:250px" }
                                            )
                    </div>
                    <!-- APPLY BUTTON -->
                    <div class="col-12 col-md-4 col-xl-auto">
                        <button type="submit"
                                class="btn btn-apply w-100 d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-funnel"></i>
                            Apply Filters
                        </button>
                    </div>
                </div>  
            }
        </div>

        <div class="col-12 col-xl-auto">
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <button class="btn btn-sm btn-outline-secondary" style="border-color:#d5dbe6;color:#0f172a"><i class="bi bi-file-earmark-excel me-1 text-success"></i>Excel</button>
                <button class="btn btn-sm btn-outline-secondary" style="border-color:#d5dbe6;color:#0f172a"><i class="bi bi-file-earmark-pdf me-1 text-danger"></i>PDF</button>
                <button class="btn btn-sm btn-outline-secondary" style="border-color:#d5dbe6;color:#0f172a"><i class="bi bi-printer me-1"></i>Print</button>
                <span class="d-none d-sm-block border-start" style="height:24px"></span>
                <button class="btn btn-sm" style="background:#eef1f6;color:#334155"><i class="bi bi-clock-history me-1"></i>Legacy Doc</button>
            </div>
        </div>
    </div>

    <hr class="my-3" style="color:#e5e9f0">
    @if (Model.ComplainList.Count > 0)
    {
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-6 col-xl-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="search" class="form-control" placeholder="Search Ticket ID, Customer, Staff ID..." aria-label="Search tickets">
                </div>
            </div>
            <div class="col-12 col-md-6 col-xl-8">
                <div class="d-flex flex-wrap align-items-center justify-content-md-end gap-2 gap-md-3 text-secondary">
                    <label class="d-flex align-items-center gap-2 mb-0">
                        Show:
                        <select class="form-select form-select-sm w-auto"><option>10 entries</option><option>25 entries</option><option>50 entries</option></select>
                    </label>
                    <span class="d-none d-md-block border-start" style="height:20px"></span>
                    <span class="d-flex align-items-center gap-2">
                        Displaying:
                        <span class="rounded-2 px-2 py-1 fw-semibold" style="background:#dbeafe;color:#1d4ed8;font-size:.75rem">10 of 148 Items</span>
                    </span>
                </div>
            </div>
        </div>
    }

</section>

<!-- Ticket list -->
<section class="panel overflow-hidden">

    <!-- Table: md and up -->
    <div class="table-responsive d-none d-md-block">
        <table class="table tickets align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-3">SL</th>
                    <th>TICKET ID</th>
                    <th>CUSTOMER NAME</th>
                    <th>CONTACT NO</th>
                    <th>CUSTOMER ADDRESS</th>
                    <th class="pe-3">PRODUCT NAME</th>
                </tr>
            </thead>
            <tbody id="ticketRows"></tbody>
        </table>
    </div>

    <!-- Cards: below md -->
    <div class="d-md-none" id="ticketCards"></div>

    <!-- Pagination -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 p-3 border-top text-secondary">
        <span>Showing <b class="text-dark">1</b> to <b class="text-dark">10</b> of <b class="text-dark">148</b> entries</span>
        <nav aria-label="Ticket pages">
            <ul class="pagination pagination-sm mb-0 flex-wrap justify-content-center">
                <li class="page-item disabled"><a class="page-link" href="#" tabindex="-1"><i class="bi bi-chevron-left"></i> Prev</a></li>
                <li class="page-item active" aria-current="page"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item d-none d-sm-block"><a class="page-link" href="#">3</a></li>
                <li class="page-item d-none d-sm-block"><a class="page-link" href="#">4</a></li>
                <li class="page-item d-none d-sm-block"><a class="page-link" href="#">5</a></li>
                <li class="page-item disabled"><span class="page-link">…</span></li>
                <li class="page-item"><a class="page-link" href="#">15</a></li>
                <li class="page-item"><a class="page-link" href="#">Next <i class="bi bi-chevron-right"></i></a></li>
            </ul>
        </nav>
    </div>
</section>










<partial name="~/Views/PartialView/_DatatableJSCode.cshtml" />