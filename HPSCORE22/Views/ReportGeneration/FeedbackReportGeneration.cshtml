@model RetailCare.Models.ReportGenerationViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<partial name="~/Views/PartialView/_DataTableCSSReport.cshtml" />
@functions {
    // Map status text -> pill colour (adjust names to match your STATUSNAME values)
    string StatusClass(string status)
    {
        var s = (status ?? "").ToLower();

        // "unsolved" must be checked BEFORE "solved", because "unsolved" contains "solved"
        if (s.Contains("unsolved")) return "red";
        if (s.Contains("solved") || s.Contains("complete")) return "green";
        if (s.Contains("cancel")) return "orange";
        return "amber"; // pending / anything else
    }
}

<div class="complain-page">

    <!-- ================= HEADER + KPIs ================= -->
    <div class="panel p-4 mb-4">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <h3 class="page-title mb-0">Feedback List</h3><br />
        </div>
        <p class="text-secondary mt-1 mb-0">Real-time service dispatches, technician timelines, and cross-district SLA tracking.</p>
    </div>

    <!-- ================= FILTER FORM ================= -->
    <div class="panel p-4 mb-4">
        @using (Html.BeginForm("FeeBackReport", "ReportGeneration", FormMethod.Post, new { @class = "row g-3 align-items-end" }))
        {
            <div class="col-md-3 col-sm-12">
                <b>@Html.LabelFor(model => model.FilteringOption.StartDate, new { @class = "form-label small fw-semibold text-secondary text-uppercase" })</b><span class="text-danger">*</span>
                @Html.TextBoxFor(model => model.FilteringOption.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                @Html.ValidationMessageFor(model => model.FilteringOption.StartDate, "", new { @class = "text-danger" })
            </div>

            <div class="col-md-3 col-sm-12">
                <b>@Html.LabelFor(model => model.FilteringOption.EndDate, new { @class = "form-label small fw-semibold text-secondary text-uppercase" })</b><span class="text-danger">*</span>
                @Html.TextBoxFor(model => model.FilteringOption.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                @Html.ValidationMessageFor(model => model.FilteringOption.EndDate, "", new { @class = "text-danger" })
            </div>

            <div class="col-md-2 col-sm-12">
                <button class="btn btn-apply w-100" type="submit"><i class="bi bi-funnel-fill me-1"></i> Show</button>
            </div>
        }
    </div>

    <!-- ================= TABLE ================= -->
    @if (Model.FeedbackReport != null && Model.FeedbackReport.Count > 0)
    {
        <div class="panel table-panel">

            <!-- Toolbar: search / page length / export -->
            <div class="p-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="search-box flex-grow-1">
                    <i class="bi bi-search"></i>
                    <input type="text" id="tblSearch" class="form-control" placeholder="Search Ticket ID, Customer, Staff ID...">
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <div class="d-flex align-items-center gap-2 text-secondary small me-2">
                        Show:
                        <select id="tblLength" class="form-select form-select-sm show-select">
                            <option value="5">5 entries</option>
                            <option value="10" selected>10 entries</option>
                            <option value="25">25 entries</option>
                            <option value="50">50 entries</option>
                        </select>
                        <span class="items-chip" id="tblDisplaying">–</span>
                    </div>

                    <button type="button" class="btn-export" id="btnExcel"><i class="bi bi-file-earmark-excel me-1"></i> Excel</button>
                    <button type="button" class="btn-export" id="btnPdf"><i class="bi bi-file-earmark-pdf me-1"></i> PDF</button>
                    <button type="button" class="btn-export" id="btnPrint"><i class="bi bi-printer me-1"></i> Print</button>
                </div>
            </div>

            <div class="table-responsive report-scroll">
                <table id="locationTable" class="table table-hover align-middle table-ticket w-100">
                    <thead>
                        <tr>
                            <th>SL</th>
                            <th>Complain Date</th>
                            <th>Ticket ID</th>
                            <th>Customer Name</th>
                            <th>Contact No</th>
                            <th>Location</th>
                            <th>Showroom Code</th>
                            <th>Product Type</th>
                            <th>Assign Person</th>
                            <th>Assign Person StaffID</th>
                            <th>Status</th>
                            <th>Working Date</th>
                            <th>Remarks</th>
                            <th>Details</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int i = 1;
                            foreach (var item in Model.FeedbackReport)
                            {
                                <tr>
                                    <td class="text-secondary">@i</td>
                                    <td>@item.COMPLAINDATE?.ToString("dd/MM/yyyy")</td>
                                    <td><span class="ticket-id">@item.TICKETCODE</span></td>
                                    <td class="cust-name wrap-col">@item.CUSTOMERNAME</td>
                                    <td class="phone"><i class="bi bi-telephone"></i> @item.CONTACTNO</td>
                                    <td class="wrap-col">@item.LOCATION</td>
                                    <td>@item.SHOWROOM</td>
                                    <td><span class="pill blue">@item.PRODUCTNAME</span></td>
                                    <td>@item.TECHNICIANNAME</td>
                                    <td class="mono">@item.STAFFID</td>
                                    <td><span class="pill @StatusClass(item.STATUSNAME)">@item.STATUSNAME</span></td>
                                    <td>@item.WORKINGDATE?.ToString("dd/MM/yyyy")</td>
                                    <td class="wrap-col remarks-column">@item.REMARKS</td>
                                    <td class="text-center">
                                        <button type="button"
                                                class="btn btn-primary btn-sm assign-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#exampleModal"
                                                onclick="showDetails('@item.TICKETCODE')">
                                            <i class="fa fa-plus-circle"></i>
                                        </button>
                                    </td>
                                </tr>
                                i++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="panel p-5 text-center text-secondary">
            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
            No complaints to show. Pick a date range and click <strong>Show</strong>.
        </div>
    }
</div>

<!-- ================= DETAILS MODAL ================= -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Problem Details</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table id="complaindetails" class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>SL</th>
                            <th>Problem Name</th>
                            <th>Quantity</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
                <div id="carouselExampleControls" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner" id="imagedetails">
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<partial name="~/Views/PartialView/_DatatableJSCodeReport.cshtml" />

<style>
    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        filter: brightness(0); /* Makes the Bootstrap arrow black */
    }

    /* ---------- Table layout fix ---------- */
    /* Wrapper scrolls horizontally instead of letting cells overlap */
    .report-scroll {
        overflow-x: auto;
    }

    /* "auto" lets each column size to its content (was "fixed", which caused the overlap) */
    #locationTable {
        width: 100%;
        table-layout: auto !important;
    }

        #locationTable th,
        #locationTable td {
            white-space: nowrap; /* short fields stay on one line */
            vertical-align: middle;
            overflow: visible;
        }

            /* Long-text columns: allow wrapping inside a sensible width range */
            #locationTable td.wrap-col {
                white-space: normal;
                word-break: break-word;
                overflow-wrap: anywhere;
                min-width: 160px;
                max-width: 260px;
            }

            #locationTable td.remarks-column {
                min-width: 200px;
                max-width: 300px;
            }

            /* Keep the Details button column compact and separate from Remarks */
            #locationTable th:last-child,
            #locationTable td:last-child {
                width: 70px;
                min-width: 70px;
                text-align: center;
            }
</style>

<script>
    // Recalculate DataTables column widths once the page has fully loaded (if DataTables is used)
    $(window).on('load', function () {
        try {
            if ($.fn.DataTable && $.fn.DataTable.isDataTable('#locationTable')) {
                $('#locationTable').DataTable().columns.adjust();
            }
        } catch (e) {
            console.log('DataTable adjust skipped:', e);
        }
    });

    function showDetails(ticketCode) {
        $.ajax({
            url: '@Url.Action("GetAllComplainProblemList", "ReportGeneration")',
            type: 'GET',
            data: { ticketcode: ticketCode },
            dataType: 'json',

            success: function (res) {

                var tbody = $("#complaindetails tbody");
                var imageBody = $("#imagedetails");

                // Clear previous data
                tbody.empty();
                imageBody.empty();

                // =========================
                // Problem Details
                // =========================
                if (res.ProblemList && res.ProblemList.length > 0) {

                    $.each(res.ProblemList, function (i, item) {

                        var row = `
                            <tr>
                                <td>${i + 1}</td>
                                <td>${item.PROBLEMNAME ?? 'N/A'}</td>
                                <td>${item.QUANTITY ?? 'N/A'}</td>
                                <td>${item.REMARKS ?? 'N/A'}</td>
                            </tr>
                        `;

                        tbody.append(row);
                    });

                } else {

                    tbody.append(`
                        <tr>
                            <td colspan="4" class="text-center">
                                No data found.
                            </td>
                        </tr>
                    `);
                }

                // =========================
                // Image Details
                // =========================
                if (res.ImageDetails && res.ImageDetails.length > 0) {

                    $.each(res.ImageDetails, function (i, images) {

                        // Remove leading slash if IMAGEPATH already starts with /
                        var imagePath = (images.IMAGEPATH || '').replace(/^\/+/, '');

                        var imageUrl = 'http://pmc.prangroup.com/AlphaCareAPI/' + imagePath;

                        var row = `
                            <div class="carousel-item ${i === 0 ? 'active' : ''}">
                                <img src="${imageUrl}"
                                     class="d-block w-100"
                                     alt="Complaint Image"
                                     style="max-height:200px; object-fit:contain;">
                            </div>
                        `;

                        imageBody.append(row);
                    });

                } else {

                    imageBody.append(`
                        <div class="text-center p-3">
                            No image found.
                        </div>
                    `);
                }
            },

            error: function (xhr, status, error) {

                console.log("Status:", status);
                console.log("Error:", error);
                console.log("Response:", xhr.responseText);

                $("#complaindetails tbody").html(`
                    <tr>
                        <td colspan="4" class="text-center text-danger">
                            Failed to load complaint details.
                        </td>
                    </tr>
                `);

                $("#imagedetails").html(`
                    <div class="text-center text-danger p-3">
                        Failed to load images.
                    </div>
                `);
            }
        });
    }
</script>
