@model RetailCare.Models.ReportGenerationViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<partial name="~/Views/PartialView/_DataTableCSS.cshtml" />
<div class="card">
    <div class="top-border"></div>
    <div class="card-header entryfromheader">
        <h3 class="card-title"> Feedback List</h3>
    </div>
    <div class="card-body">

        @using (Html.BeginForm("FeeBackReport", "ReportGeneration", FormMethod.Post, new { @class = "form-inline" }))
        {
            <div class="row" style="padding: 1%;margin-left: 7%;">
                <div class="col-md-4 col-sm-12">
                    @Html.LabelFor(model => model.FilteringOption.StartDate, new { @class = "control-label" })<span style="color:red">*</span>
                    @Html.TextBoxFor(model => model.FilteringOption.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    @Html.ValidationMessageFor(model => model.FilteringOption.StartDate, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-4 col-sm-12">
                    @Html.LabelFor(model => model.FilteringOption.EndDate, new { @class = "control-label" })<span style="color:red">*</span>
                    @Html.TextBoxFor(model => model.FilteringOption.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    @Html.ValidationMessageFor(model => model.FilteringOption.EndDate, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-4 col-sm-12 mt-3">
                    <button class="btn btn-success" type="submit">Show</button>
                </div>
            </div>
        }

        @if (Model.FeedbackReport.Count > 0)
        {
            <div class="row">
                <div class="col-sm-12">
                    <table id="locationTable" class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>SL</th>
                                <th>Complain Date</th>
                                <th>Ticket ID</th>
                                <th>Customer Name</th>
                                <th>Contact No</th>
                                <th>Location</th>
                                <th>Showroom Code</th>
                                <th>Product Type</th>
                                <th>Assign Person</th>
                                <th>Assign Person StaffID</th>
                                <th>Status</th>
                                <th>Working Date</th>
                                <th>Remarks</th>
                                <th>Details</th>
                           </tr>
                        </thead>

                        <tbody>
                            @{
                                int i = 1;
                                @foreach (var item in Model.FeedbackReport)
                                {
                                    <tr>
                                        <td>@i</td>
                                        <td>@item.COMPLAINDATE?.ToString("dd/MM/yyyy")</td>
                                        <td>@item.TICKETCODE</td>
                                        <td>@item.CUSTOMERNAME</td>
                                        <td>@item.CONTACTNO</td>
                                        <td>@item.LOCATION</td>
                                        <td>@item.SHOWROOM</td>
                                        <td>@item.PRODUCTNAME</td>
                                        <td>@item.TECHNICIANNAME</td>
                                        <td>@item.STAFFID</td>
                                        <td>@item.STATUSNAME</td>
                                        <td>@item.WORKINGDATE?.ToString("dd/MM/yyyy")</td>
                                        <td class="remarks-column">@item.REMARKS</td>
                                        <!-- Action column -->
                                        <td>
                                            <button type="button"
                                                    class="btn btn-primary btn-sm assign-btn"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#exampleModal"
                                                    onclick="showDetails('@item.TICKETCODE')">
                                                <i class="fa fa-plus-circle"></i>
                                            </button>
                                        </td>
                                    </tr>
                                    i++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {

        }


    </div>
</div>
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Problem Details</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table id="complaindetails" class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>SL</th>
                            <th>Problem Name</th>
                            <th>Quantity</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
                <div id="carouselExampleControls" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner" id="imagedetails">
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<partial name="~/Views/PartialView/_DatatableJSCode.cshtml" />
<style>
    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        filter: brightness(0); /* Makes the Bootstrap arrow black */
    }

    #locationTable {
        width: 100%;
        table-layout: fixed;
    }

        #locationTable .remarks-column {
            width: 180px !important;
            max-width: 180px !important;
            white-space: normal !important;
            overflow-wrap: break-word;
            word-break: break-word;
        }
</style>
<script>
    function showDetails(ticketCode) {
        $.ajax({
            url: '@Url.Action("GetAllComplainProblemList", "ReportGeneration")',
            type: 'GET',
            data: { ticketcode: ticketCode },
            dataType: 'json',

            success: function (res) {

                console.log(res);

                var tbody = $("#complaindetails tbody");
                var imageBody = $("#imagedetails");

                // Clear previous data
                tbody.empty();
                imageBody.empty();

                // =========================
                // Problem Details
                // =========================
                if (res.ProblemList && res.ProblemList.length > 0) {

                    $.each(res.ProblemList, function (i, item) {

                        var row = `
                            <tr>
                                <td>${i + 1}</td>
                                <td>${item.PROBLEMNAME ?? 'N/A'}</td>
                                <td>${item.QUANTITY ?? 'N/A'}</td>
                                <td>${item.REMARKS ?? 'N/A'}</td>
                            </tr>
                        `;

                        tbody.append(row);
                    });

                } else {

                    tbody.append(`
                        <tr>
                            <td colspan="4" class="text-center">
                                No data found.
                            </td>
                        </tr>
                    `);
                }


                // =========================
                // Image Details
                // =========================
                if (res.ImageDetails && res.ImageDetails.length > 0) {

                    $.each(res.ImageDetails, function (i, images) {

                        // Remove leading slash if IMAGEPATH already starts with /
                        var imagePath = images.IMAGEPATH || '';

                        imagePath = imagePath.replace(/^\/+/, '');

                        var imageUrl =
                            'http://pmc.prangroup.com/AlphaCareAPI/' + imagePath;

                        var row = `
                            <div class="carousel-item ${i === 0 ? 'active' : ''}">
                                <img src="${imageUrl}"
                                     class="d-block w-100"
                                     alt="Complaint Image"
                                     style="max-height:200px; object-fit:contain;">
                            </div>
                        `;

                        imageBody.append(row);
                    });

                } else {

                    imageBody.append(`
                        <div class="text-center p-3">
                            No image found.
                        </div>
                    `);
                }
            },

            error: function (xhr, status, error) {

                console.log("Status:", status);
                console.log("Error:", error);
                console.log("Response:", xhr.responseText);

                $("#complaindetails tbody").html(`
                    <tr>
                        <td colspan="4" class="text-center text-danger">
                            Failed to load complaint details.
                        </td>
                    </tr>
                `);

                $("#imagedetails").html(`
                    <div class="text-center text-danger p-3">
                        Failed to load images.
                    </div>
                `);
            }
        });
    }
</script>