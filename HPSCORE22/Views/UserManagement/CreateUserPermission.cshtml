@model RetailCare.Models.UserWiseMenuPermissionViewModel
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
}
<!-- JS -->
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<!-- Bootstrap 5 + Bootstrap Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/AlphaCare/assets/css/SetupCss.css" asp-append-version="true" />

<div class="container-fluid px-3">
    @using (Html.BeginForm("SaveUserPermission", "UserManagement", FormMethod.Post, new { @class = "form-card", id = "technicianForm" }))
    {
        <!-- ===================== 01 PERSONAL ===================== -->
        <div class="form-section">
            <div class="section-head">
                <span class="section-num">01</span>
                <div>
                    <h2 class="section-title">Role Wise Menu Permission</h2><br />
                    <p class="section-sub">Basic identification, company staff tag, and direct communications.</p>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-12 col-sm-6 col-lg-3">
                    <label class="form-label">Role</label>
                    <select name="userID" id="UserIDDetails" class="form-control">
                        <option value="">Select Role</option>
                        @foreach (var UserInfo in Model.RoleList)
                        {
                            <option value="@UserInfo.TYPEID">@UserInfo.TYPENAME</option>
                        }

                    </select>
                </div>
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="status-box mt-4">
                        @Html.CheckBox(
                        "UserWiseMenus.CheckedBox",
                                        true, // checked by default
                                        new
                                        {
                                            id = "chkActive",
                                            @class = "form-check-input"
                                        })
                    <label for="isActive" class="mb-0" style="cursor:pointer">Is Active</label>
                </div>
            </div>
        </div>
    </div>
    <!-- ===================== 02 SKILLS ===================== -->
    <div class="form-section ">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3">
            <div class="section-head mb-0">
                <span class="section-num">02</span>
                <div>
                    <h2 class="section-title">
                       Menu List
                    </h2>
                </div>
            </div>
        </div>

        <div class="row g-2 classitems" id="">
            @foreach (var item in Model.Menus)
                {
                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               name="CheckingMenuList"
                               value="@item.MENUID"
                               id="class_@item.MENUID"
                               @(Model.CheckingMenuList != null && Model.CheckingMenuList.Contains(item.MENUID) ? "checked" : "") />

                        <label class="form-control-label" for="class_@item.MENUID">
                            @item.TITLE
                        </label>
                    </div>
                }
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2" style="padding: 1%;float: right;">
            <button type="submit" class="btn btn-success"><i class="bi bi-check2 me-1"></i> Save</button>
        </div>
    }
</div>

<style>
    .classitems {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr;
        gap: 2%;
    }

    .req {
        color: red;
    }
</style>
<script>
    $(document).ready(function () {

        $("#UserIDDetails").on("change", function () {
           EditPermission($(this).val());
        });

    });
    function EditPermission(userId) {

        $.ajax({
            url: '@Url.Action("GetALlUserPermission", "UserManagement")',
            type: 'GET',
            data: { UserId: userId },

            success: function (response) {

                console.log("Permission Response:", response);

                // Uncheck all menus first
                $(".form-check-input").prop("checked", false);

                if (!response.success) {
                    alert(response.message);
                    return;
                }

                $.each(response.data, function (i, item) {

                    console.log("ItemId:", item.MENUID);
                    console.log("Active:", item.ACTIVE);

                    if (item.ACTIVE === 1) {

                        $("#class_" + item.MENUID).prop("checked", true);

                    }
                });
            },

            error: function (xhr, status, error) {

                console.log("AJAX ERROR");
                console.log("Status:", status);
                console.log("Error:", error);
                console.log("Response:", xhr.responseText);

                alert("Failed to load user permissions.");
            }
        });
    }
</script>