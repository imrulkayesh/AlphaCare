@model RetailCare.Models.RolewiseMenuPermissionViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- ADD JQUERY -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css"
      rel="stylesheet" />
<div class="row">
    <div class="card frombody">
        <div class="top-border"></div>
        <div class="card-header entryfromheader">
            <h3 class="card-title"> ADD New Role</h3>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("SaveBrandData", "ProductManagement", FormMethod.Post, new { @class = "form-floating" }))
            {
                <div class="row">
                    @Html.HiddenFor(m => m.RoleDetails.TYPEID)
                    <div class="col-md-12 col-sm-12 mt-1">
                        <div class="">
                            @Html.LabelFor(m => m.RoleDetails.TYPENAME, htmlAttributes: new { @class = "form-control-label" })<span style="color:red">*</span>
                            @Html.TextBoxFor(m => m.RoleDetails.TYPENAME, new { @class = "form-control", id = "CONTACTNO" })
                            @Html.ValidationMessageFor(m => m.RoleDetails.TYPENAME, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                if (Model.RoleDetails.TYPEID > 0)
                {
                    <div class="mt-3 col-sm-12">
                        <button type="submit" class="btn btn-primary" style="float: right !important; background-color:red">Update</button>
                    </div>
                }
                else
                {
                    <div class="mt-3 col-sm-12">
                        <button type="submit" class="btn btn-primary" style="float: right !important;background-color:green">Save</button>
                    </div>
                }
            }
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="card">
        <div class="top-border"></div>
        <div class="card-header entryfromheader">
            <h3 class="card-title">Role List</h3>
        </div>
        <div class="card-body">
            <table id="locationTable" class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>SL</th>
                        <th>Role Name</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        int i = 1;
                        @foreach (var item in Model.RoleList)
                        {
                            <tr>
                                <td>@i</td>
                                <td>@item.TYPENAME</td>
                                <td class="text-center">
                                    <a asp-action="EditRoleType"
                                       asp-controller="UserManagement"
                                       asp-route-id="@item.TYPEID"
                                       class="btn btn-primary btn-sm assign-btn">
                                        <i class="fas fa-arrow-alt-circle-right"></i>
                                    </a>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- JS -->
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<!--Data Table-->
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script>
    $(document).ready(function () {
        $('#locationTable').DataTable({
            pageLength: 5,
            lengthMenu: [5, 10, 25, 50],
            ordering: true,
            searching: true,
            paging: true,
            info: true,
            autoWidth: false,
            responsive: true, // ✅ better UI

            language: {
                search: "🔍 Search:",
                lengthMenu: "Show _MENU_ entries",
                zeroRecords: "No matching locations found",
                info: "Showing _START_ to _END_ of _TOTAL_ locations",
                infoEmpty: "No data available"
            },

            columnDefs: [
                { orderable: false, targets: 2 } // action column
            ]
        });
    });

    function confirmDelete() {
        return confirm("⚠️ Are you sure you want to delete?");
    }
</script>