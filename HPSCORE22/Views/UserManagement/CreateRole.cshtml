@model RetailCare.Models.RolewiseMenuPermissionViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- JS -->
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<!-- Bootstrap 5 + Bootstrap Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/AlphaCare/assets/css/SetupCss.css" asp-append-version="true" />

<div class="container-fluid px-3">
    @using (Html.BeginForm("SaveBrandData", "ProductManagement", FormMethod.Post, new { @class = "form-card" }))
    {
        <!-- ===================== 01 PERSONAL ===================== -->
        <div class="form-section">
            <div class="section-head">
                <span class="section-num">01</span>
                <div>
                    <h2 class="section-title">ADD New Role</h2><br />
                    <p class="section-sub">Basic identification, company staff tag, and direct communications.</p>
                </div>
            </div>
            @Html.HiddenFor(m => m.RoleDetails.TYPEID)
            <div class="row g-3">
                <div class="col-12 col-sm-12 col-lg-12">
                    @Html.LabelFor(m => m.RoleDetails.TYPENAME, htmlAttributes: new { @class = "form-control-label" })<span style="color:red">*</span>
                    @Html.TextBoxFor(m => m.RoleDetails.TYPENAME, new { @class = "form-control", id = "CONTACTNO" })
                    @Html.ValidationMessageFor(m => m.RoleDetails.TYPENAME, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        @if (Model.RoleDetails.TYPEID > 0)
        {
            <div class="d-flex flex-wrap gap-2" style="padding: 1%;float: right;">
                <button type="submit" class="btn btn-danger"><i class="bi bi-check2 me-1"></i> Update</button>
            </div>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2" style="padding: 1%;float: right;">
                <button type="submit" class="btn btn-success"><i class="bi bi-check2 me-1"></i> Save</button>
            </div>
        }
    }
</div>
<div class="complain-page">

    <!-- ================= HEADER + KPIs ================= -->
    <div class="panel p-4 mb-4">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <h3 class="page-title mb-0">Roles List</h3>
            <p>Basic identification, company staff tag, and direct communications.</p>
        </div>

    </div>
    <div class="panel table-panel">

        <!-- Toolbar: search / page length / export -->
        <div class="p-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="search-box flex-grow-1">
                <i class="bi bi-search"></i>
                <input type="text" id="tblSearch" class="form-control" placeholder="Search Name,Contact No, Staff ID...">
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
                <div class="d-flex align-items-center gap-2 text-secondary small me-2">
                    Show:
                    <select id="tblLength" class="form-select form-select-sm show-select">
                        <option value="5">5 entries</option>
                        <option value="10" selected>10 entries</option>
                        <option value="25">25 entries</option>
                        <option value="50">50 entries</option>
                    </select>
                    <span class="items-chip" id="tblDisplaying">–</span>
                </div>
            </div>
        </div>

        <div class="table-responsive report-scroll">
            <table id="locationTable" class="table table-hover align-middle table-ticket w-100">
                <thead>
                    <tr>
                        <th>SL</th>
                        <th>Role Name</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        int i = 1;
                        foreach (var item in Model.RoleList)
                        {
                            <tr>
                                <td class="text-secondary">@i</td>
                                <td>@item.TYPENAME</td>
                                <td class="text-center">
                                    <a asp-action="EditRoleType"
                                       asp-controller="UserManagement"
                                       asp-route-id="@item.TYPEID"
                                       class="btn btn-primary btn-sm assign-btn">
                                        <i class="fas fa-arrow-alt-circle-right"></i>
                                    </a>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


<partial name="~/Views/PartialView/_DataTableCSSReport.cshtml" />
<partial name="~/Views/PartialView/_DatatableJSCodeReport.cshtml" />
<style>
    .classitems {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr;
        gap: 2%;
    }

    .req {
        color: red;
    }
</style>
<script>
    $(document).ready(function () {

        $("#UserIDDetails").on("change", function () {
           EditPermission($(this).val());
        });

    });
    function EditPermission(userId) {

        $.ajax({
            url: '@Url.Action("GetALlUserPermission", "UserManagement")',
            type: 'GET',
            data: { UserId: userId },

            success: function (response) {

                console.log("Permission Response:", response);

                // Uncheck all menus first
                $(".form-check-input").prop("checked", false);

                if (!response.success) {
                    alert(response.message);
                    return;
                }

                $.each(response.data, function (i, item) {

                    console.log("ItemId:", item.MENUID);
                    console.log("Active:", item.ACTIVE);

                    if (item.ACTIVE === 1) {

                        $("#class_" + item.MENUID).prop("checked", true);

                    }
                });
            },

            error: function (xhr, status, error) {

                console.log("AJAX ERROR");
                console.log("Status:", status);
                console.log("Error:", error);
                console.log("Response:", xhr.responseText);

                alert("Failed to load user permissions.");
            }
        });
    }
</script>